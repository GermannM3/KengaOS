/* kf_pci.kenga — доступ к конфигурационному пространству PCI на языке Kenga.
 *
 * 32-битного порт-ввода в Kenga нет (только asm_inb/asm_outb, 8 бит), поэтому
 * 32-битные значения собираются побайтово.
 *
 * ВАЖНО про emit-c: каждый инлайн asm_inb порождает ЛОКАЛЬНУЮ переменную
 * _k_port_in. Два вызова в одной области видимости дают "redefinition of
 * '_k_port_in'". Поэтому здесь НА КАЖДЫЙ интринсик — своя функция, а не
 * несколько вызовов в одном выражении.
 *
 * Порты: 0xCF8 = 3320 (адрес), 0xCFC = 3324 (данные).
 */

/* Однобайтовые обёртки: ровно один интринсик на функцию. */
fn in8(p: i64) -> i64 { return asm_inb(p); }
fn out8(p: i64, v: i64) -> i64 { asm_outb(p, v); return 0; }

/* Прочитать 32 бита конфигурации: bus/dev/fun, регистр reg (выравнен по 4). */
fn pci_cfg32(bus: i64, dev: i64, fun: i64, reg: i64) -> i64 {
    let addr: i64 = 2147483648 + bus * 65536 + dev * 2048 + fun * 256 + (reg - (reg & 3));
    out8(3320, addr & 255);
    out8(3321, (addr >> 8) & 255);
    out8(3322, (addr >> 16) & 255);
    out8(3323, (addr >> 24) & 255);
    let b0: i64 = in8(3324);
    let b1: i64 = in8(3325);
    let b2: i64 = in8(3326);
    let b3: i64 = in8(3327);
    return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216;
}

/* Идентификатор устройства 00:00.0 — контрольный признак, что PCI доступен. */
fn pci_dev0() -> i64 { return pci_cfg32(0, 0, 0, 0); }

/* Сколько устройств заданного класса в шинах 0..3 (0x02 — сеть, 0x04 — звук). */
fn pci_count_class(cls: i64) -> i64 {
    let n: i64 = 0;
    let bus: i64 = 0;
    while bus < 4 {
        let dev: i64 = 0;
        while dev < 16 {
            let v: i64 = pci_cfg32(bus, dev, 0, 8);
            if ((v >> 24) & 255) == cls { n = n + 1; }
            dev = dev + 1;
        }
        bus = bus + 1;
    }
    return n;
}
