/* kf_pci.kenga — доступ к конфигурационному пространству PCI на языке Kenga.
 *
 * ВАЖНО: конфиг PCI требует доступа РОВНО 32 битами — регистр адреса (порт
 * 0xCF8) не принимает побайтовые записи, и попытка собрать значение из
 * asm_inb/asm_outb давала мусор (0x33111111 вместо 0x8086...).  Поэтому здесь
 * используются 32-битные порт-интринсики asm_inl/asm_outl.
 *
 * Про emit-c: каждый инлайн порт-интринсика порождает локальную переменную,
 * поэтому на функцию — не более одного вызова в области видимости.
 *
 * Порты: 0xCF8 = 3320 (адрес), 0xCFC = 3324 (данные).
 */

@intrinsic fn asm_inl(p: i64) -> i64;
@intrinsic fn asm_outl(p: i64, v: i64);

/* Прочитать 32 бита конфигурации: bus/dev/fun, регистр reg (выравнен по 4). */
fn pci_cfg32(bus: i64, dev: i64, fun: i64, reg: i64) -> i64 {
    let addr: i64 = 2147483648 + bus * 65536 + dev * 2048 + fun * 256 + (reg - (reg & 3));
    asm_outl(3320, addr);
    return asm_inl(3324);
}

/* Идентификатор устройства 00:00.0. В QEMU это 0x8086:0x1237 (i440fx) или
   0x8086:0x29c0 (q35) — младшие 16 бит должны быть 0x8086 (32902). */
fn pci_dev0() -> i64 { return pci_cfg32(0, 0, 0, 0); }

/* Сколько устройств заданного класса в шинах 0..3 (0x02 — сеть, 0x04 — звук). */
fn pci_count_class(cls: i64) -> i64 {
    let n: i64 = 0;
    let bus: i64 = 0;
    while bus < 4 {
        let dev: i64 = 0;
        while dev < 16 {
            let v: i64 = pci_cfg32(bus, dev, 0, 8);
            if ((v >> 24) & 255) == cls { n = n + 1; }
            dev = dev + 1;
        }
        bus = bus + 1;
    }
    return n;
}
