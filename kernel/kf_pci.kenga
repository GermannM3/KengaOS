/* kf_pci.kenga — PCI на языке Kenga + первый доступ к MMIO сетевого контроллера.
 *
 * Конфиг PCI требует доступа РОВНО 32 битами, поэтому используются встроенные
 * интринсики emit-c asm_inl/asm_outl (побайтовые записи в 0xCF8 игнорируются).
 * Каждый инлайн порт-интринсика порождает локальную переменную, поэтому на
 * функцию — не более одного вызова.
 *
 * Порты: 0xCF8 = 3320 (адрес), 0xCFC = 3324 (данные).
 */

@intrinsic fn asm_inl(p: i64) -> i64;
@intrinsic fn asm_outl(p: i64, v: i64);

/* Прочитать 32 бита конфигурации: bus/dev/fun, регистр reg (выравнен по 4). */
fn pci_cfg32(bus: i64, dev: i64, fun: i64, reg: i64) -> i64 {
    let addr: i64 = 2147483648 + bus * 65536 + dev * 2048 + fun * 256 + (reg - (reg & 3));
    asm_outl(3320, addr);
    return asm_inl(3324);
}

/* Идентификатор устройства 00:00.0 (в QEMU -M pc это 0x8086:0x1237). */
fn pci_dev0() -> i64 { return pci_cfg32(0, 0, 0, 0); }

/* Сколько устройств класса cls (0x02 — сеть, 0x04 — звук) в шинах 0..3. */
fn pci_count_class(cls: i64) -> i64 {
    let n: i64 = 0;
    let bus: i64 = 0;
    while bus < 4 {
        let dev: i64 = 0;
        while dev < 16 {
            let v: i64 = pci_cfg32(bus, dev, 0, 8);
            if ((v >> 24) & 255) == cls { n = n + 1; }
            dev = dev + 1;
        }
        bus = bus + 1;
    }
    return n;
}

/* Адрес первого устройства класса cls в виде bus*256+dev; -1 если нет. */
fn pci_find_class(cls: i64) -> i64 {
    let found: i64 = -1;
    let bus: i64 = 0;
    while bus < 4 {
        let dev: i64 = 0;
        while dev < 16 {
            let v: i64 = pci_cfg32(bus, dev, 0, 8);
            if ((v >> 24) & 255) == cls { if found < 0 { found = bus * 256 + dev; } }
            dev = dev + 1;
        }
        bus = bus + 1;
    }
    return found;
}

/* BAR0 устройства по адресу a=bus*256+dev: база MMIO (младшие биты — тип). */
fn pci_bar0(a: i64) -> i64 {
    let bus: i64 = a / 256;
    let dev: i64 = a - bus * 256;
    let raw: i64 = pci_cfg32(bus, dev, 0, 16);
    return raw - (raw & 15);
}

/* Идентификатор найденного сетевого устройства (vendor|device<<16), -1 если нет. */
fn pci_nic_id() -> i64 {
    let a: i64 = pci_find_class(2);
    if a < 0 { return -1; }
    let bus: i64 = a / 256;
    let dev: i64 = a - bus * 256;
    return pci_cfg32(bus, dev, 0, 0);
}

/* --- e1000 (Intel 82540EM): первые шаги драйвера сети ---------------------
 * Регистры MAC лежат в MMIO по смещениям 0x5400 (RAL) и 0x5404 (RAH);
 * физический адрес BAR0 доступен через HHDM (интринсик kf_get_hhdm).
 */

fn e1000_mac_lo(bar0: i64) -> i64 { return mmio_read32(bar0 + kf_get_hhdm() + 21504); }
fn e1000_mac_hi(bar0: i64) -> i64 { return mmio_read32(bar0 + kf_get_hhdm() + 21508); }
/* --- e1000 (Intel 82540EM): операции с MMIO -------------------------------
 * Как и с портами: один инлайн mmio-интринсика порождает локальную переменную,
 * поэтому на функцию — не более одного вызова. Обёртки ниже это соблюдают.
 */

fn mm_r32(a: i64) -> i64 { return mmio_read32(a); }
fn mm_w32(a: i64, v: i64) -> i64 { mmio_write32(a, v); return 0; }

fn e1000_va(bar0: i64) -> i64 { return bar0 + kf_get_hhdm(); }
fn e1000_ctrl(bar0: i64) -> i64 { return mm_r32(e1000_va(bar0)); }
fn e1000_status(bar0: i64) -> i64 { return mm_r32(e1000_va(bar0) + 8); }

/* Сброс контроллера: выставить CTRL.RST (бит 26) и дождаться самосброса.
   Возвращает 0, если устройство ответило (бит снялся сам), -1 при таймауте.
   Это первая РЕАЛЬНАЯ операция записи в сетевое устройство. */
fn e1000_reset(bar0: i64) -> i64 {
    let c: i64 = mm_r32(e1000_va(bar0));
    mm_w32(e1000_va(bar0), c + 67108864);
    let i: i64 = 0;
    while i < 200000 {
        let c2: i64 = mm_r32(e1000_va(bar0));
        if (c2 & 67108864) == 0 { return 0; }
        i = i + 1;
    }
    return -1;
}
/* --- Кольцо приёма e1000 -------------------------------------------------
 * RDBAL (0x2800) — физический адрес кольца дескрипторов, RDLEN (0x2808) —
 * его длина в байтах. Физический адрес обязателен: устройство работает по DMA.
 * Дескриптор e1000 — 16 байт, на страницу 4 КиБ их влезает 256.
 */
fn e1000_rx_init(bar0: i64) -> i64 {
    let ring: i64 = mem_palloc();
    let pa: i64 = mem_virt_to_phys(ring);
    mm_w32(bar0 + kf_get_hhdm() + 10240, pa);
    mm_w32(bar0 + kf_get_hhdm() + 10248, 128);
    mm_w32(bar0 + kf_get_hhdm() + 10256, 0);   /* RDH = 0 */
    mm_w32(bar0 + kf_get_hhdm() + 10264, 7);   /* RDT = 7 (8 дескрипторов) */
    return ring;   /* CPU пишет дескрипторы по ВИРТУАЛЬНОМУ адресу */
}

fn e1000_rdbal(bar0: i64) -> i64 { return mm_r32(bar0 + kf_get_hhdm() + 10240); }
fn e1000_rdlen(bar0: i64) -> i64 { return mm_r32(bar0 + kf_get_hhdm() + 10248); }
/* Буферы приёма: 8 буферов по 2048 байт — это 4 страницы по 4 КиБ. */
fn mm_w8(a: i64, v: i64) -> i64 { mmio_write8(a, v); return 0; }
fn mm_w16(a: i64, v: i64) -> i64 { mmio_write16(a, v); return 0; }

/* Заполнить дескриптор i: физический адрес буфера, длина, статус = 0. */
fn e1000_rx_desc(ring: i64, i: i64, buf_pa: i64, len: i64) -> i64 {
    let lo: i64 = buf_pa - (buf_pa >> 32) * 4294967296;
    let hi: i64 = buf_pa >> 32;
    mm_w32(ring + i * 16, lo);
    mm_w32(ring + i * 16 + 4, hi);
    mm_w16(ring + i * 16 + 8, len);
    mm_w8(ring + i * 16 + 12, 0);
    return 0;
}

/* Включить приём: раздать буферы и выставить RCTL = EN | SBP | BAM | BSIZE 2048.
   Возвращает прочитанный ОБРАТНО RCTL — вердикт печатает ядро. */
fn e1000_rx_enable(bar0: i64, ring: i64) -> i64 {
    let p0: i64 = mem_palloc();
    let p1: i64 = mem_palloc();
    let p2: i64 = mem_palloc();
    let p3: i64 = mem_palloc();
    let b0: i64 = mem_virt_to_phys(p0);
    let b1: i64 = mem_virt_to_phys(p1);
    let b2: i64 = mem_virt_to_phys(p2);
    let b3: i64 = mem_virt_to_phys(p3);
    e1000_rx_desc(ring, 0, b0, 2048);
    e1000_rx_desc(ring, 1, b0 + 2048, 2048);
    e1000_rx_desc(ring, 2, b1, 2048);
    e1000_rx_desc(ring, 3, b1 + 2048, 2048);
    e1000_rx_desc(ring, 4, b2, 2048);
    e1000_rx_desc(ring, 5, b2 + 2048, 2048);
    e1000_rx_desc(ring, 6, b3, 2048);
    e1000_rx_desc(ring, 7, b3 + 2048, 2048);
    mm_w32(bar0 + kf_get_hhdm() + 256, 67141634);   /* RCTL: EN|SBP|BAM, BSIZE 2048 */
    return mm_r32(bar0 + kf_get_hhdm() + 256);
}

fn e1000_rdh(bar0: i64) -> i64 { return mm_r32(bar0 + kf_get_hhdm() + 10256); }
/* --- Кольцо передачи e1000 -----------------------------------------------
 * TDBAL (0x3800) — физический адрес кольца дескрипторов, TDLEN (0x3808) —
 * длина, TDH (0x3810) — что уже отправлено, TDT (0x3818) — что подготовлено,
 * TCTL (0x0400) — управление (EN | PSP).
 */
fn e1000_tx_init(bar0: i64) -> i64 {
    let ring: i64 = mem_palloc();
    let pa: i64 = mem_virt_to_phys(ring);
    mm_w32(bar0 + kf_get_hhdm() + 14336, pa);    /* TDBAL */
    mm_w32(bar0 + kf_get_hhdm() + 14344, 128);   /* TDLEN: 8 × 16 */
    mm_w32(bar0 + kf_get_hhdm() + 14352, 0);     /* TDH = 0 */
    mm_w32(bar0 + kf_get_hhdm() + 14360, 0);     /* TDT = 0 */
    mm_w32(bar0 + kf_get_hhdm() + 1024, 10);     /* TCTL = EN | PSP */
    return ring;   /* CPU пишет дескрипторы по виртуальному адресу */
}

fn e1000_tdbal(bar0: i64) -> i64 { return mm_r32(bar0 + kf_get_hhdm() + 14336); }
fn e1000_tdlen(bar0: i64) -> i64 { return mm_r32(bar0 + kf_get_hhdm() + 14344); }
fn e1000_tctl(bar0: i64) -> i64 { return mm_r32(bar0 + kf_get_hhdm() + 1024); }
/* --- Отправка ARP-запроса -----------------------------------------------
 * Кадр: Ethernet (dst MAC broadcast, src MAC наш, тип 0x0806) + ARP-запрос
 * «кто такой 10.0.2.2» (адрес шлюза QEMU/slirp) от 10.0.2.15 (наш адрес).
 * Кадр пишется прямо в DMA-буфер, затем дескриптор передачи и TDT++.
 * Возвращает упакованный вердикт: tdh*100 + шаг.
 */
fn e1000_build_arp(buf: i64) -> i64 {
    /* ВАЖНО: только hex-литералы. Ручной перевод hex->decimal я уже один раз
       сделал неверно (ethertype вышел 0x0008 вместо 0x0806), из-за чего кадр
       был мусорным и ответа не приходило. */
    mm_w32(buf,      0xFFFFFFFF);   /* dst MAC: ff ff ff ff (broadcast) */
    mm_w32(buf + 4,  0x5452FFFF);   /* ff ff | 52 54 */
    mm_w32(buf + 8,  0x56341200);   /* 00 12 34 56 — наш MAC */
    mm_w32(buf + 12, 0x01000608);   /* 08 06 (ARP) | 00 01 (Ethernet) */
    mm_w32(buf + 16, 0x04060008);   /* 08 00 (IPv4) | 06 | 04 */
    mm_w32(buf + 20, 0x54520100);   /* 00 01 (запрос) | 52 54 */
    mm_w32(buf + 24, 0x56341200);   /* 00 12 34 56 — отправитель */
    mm_w32(buf + 28, 0x0F02000A);   /* 0A 00 02 0F = 10.0.2.15 */
    mm_w32(buf + 32, 0);            /* искомый MAC: нули */
    mm_w32(buf + 36, 0x000A0000);   /* 00 00 | 0A 00 */
    mm_w32(buf + 40, 0x00000202);   /* 02 02 -> 10.0.2.2 */
    return 42;
}

/* Отправить ARP и дождаться, пока контроллер обработает дескриптор (TDH=1). */
fn e1000_arp(bar0: i64, txring: i64) -> i64 {
    let buf: i64 = mem_palloc();
    let pa: i64 = mem_virt_to_phys(buf);
    e1000_build_arp(buf);
    let lo: i64 = pa - (pa >> 32) * 4294967296;
    mm_w32(txring, lo);
    mm_w32(txring + 4, pa >> 32);
    mm_w16(txring + 8, 42);
    mm_w8(txring + 11, 11);   /* cmd = EOP | IFCS | RS */
    mm_w8(txring + 12, 0);    /* status: DD ещё не выставлен */
    mm_w32(bar0 + kf_get_hhdm() + 14360, 1);   /* TDT = 1: отправляй */
    let i: i64 = 0;
    let tdh: i64 = 0;
    while i < 200000 {
        tdh = mm_r32(bar0 + kf_get_hhdm() + 14352);
        if tdh == 1 { i = 200000; } else { i = i + 1; }
    }
    /* Ответ приходит не мгновенно, поэтому после отправки ждём сдвига RDH. */
    let j: i64 = 0;
    let rdh: i64 = 0;
    while j < 2000000 {
        rdh = mm_r32(bar0 + kf_get_hhdm() + 10256);
        if rdh != 0 { j = 2000000; } else { j = j + 1; }
    }
    if rdh == 0 { return tdh * 100; }
    return tdh * 100 + rdh + 5000;   /* +5000: ответ получен (видно в выводе) */
}
