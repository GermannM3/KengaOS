/* kf_pci.kenga — PCI на языке Kenga + первый доступ к MMIO сетевого контроллера.
 *
 * Конфиг PCI требует доступа РОВНО 32 битами, поэтому используются встроенные
 * интринсики emit-c asm_inl/asm_outl (побайтовые записи в 0xCF8 игнорируются).
 * Каждый инлайн порт-интринсика порождает локальную переменную, поэтому на
 * функцию — не более одного вызова.
 *
 * Порты: 0xCF8 = 3320 (адрес), 0xCFC = 3324 (данные).
 */

@intrinsic fn asm_inl(p: i64) -> i64;
@intrinsic fn asm_outl(p: i64, v: i64);

/* Прочитать 32 бита конфигурации: bus/dev/fun, регистр reg (выравнен по 4). */
fn pci_cfg32(bus: i64, dev: i64, fun: i64, reg: i64) -> i64 {
    let addr: i64 = 2147483648 + bus * 65536 + dev * 2048 + fun * 256 + (reg - (reg & 3));
    asm_outl(3320, addr);
    return asm_inl(3324);
}

/* Записать 32 бита конфигурации PCI. */
fn pci_cfg_write32(bus: i64, dev: i64, fun: i64, reg: i64, val: i64) -> i64 {
    let addr: i64 = 2147483648 + bus * 65536 + dev * 2048 + fun * 256 + (reg - (reg & 3));
    asm_outl(3320, addr);
    asm_outl(3324, val);
    return 0;
}

/* Включить доступ к памяти и BUS MASTER (PCI command, биты 0-2).
   Без bus-master устройство физически не может делать DMA: ни прочитать
   дескриптор, ни забрать данные кадра. У AHCI/NVMe это делает их драйвер,
   у e1000 этого не делал никто. Возвращает прочитанную команду. */
fn pci_enable_bus_master(a: i64) -> i64 {
    let bus: i64 = a / 256;
    let dev: i64 = a - bus * 256;
    let cmd: i64 = pci_cfg32(bus, dev, 0, 4);
    pci_cfg_write32(bus, dev, 0, 4, cmd + 7);
    return pci_cfg32(bus, dev, 0, 4);
}

/* ДИАГНОСТИКА: работает ли ЗАПИСЬ конфига вообще. Ставим безобидный бит 4
   (Memory Write Invalidate) и читаем обратно: если бит появился — запись
   работает и проблема только в бите BUS MASTER; если нет — запись не проходит. */
/* Записать ТОЛЬКО слово COMMAND (16 бит) в регистр 0x04. Запись двойного
   слова захватывала бы и STATUS (0x06), где биты гасятся записью единиц
   (RW1C), поэтому пишем ровно 16 бит. */
fn pci_cmd_set(a: i64, v: i64) -> i64 {
    let bus: i64 = a / 256;
    let dev: i64 = a - bus * 256;
    let addr: i64 = 2147483648 + bus * 65536 + dev * 2048 + 4;
    asm_outl(3320, addr);
    asm_outw(3324, v);
    return pci_cfg32(bus, dev, 0, 4);
}

fn pci_cmd_probe(a: i64) -> i64 {
    let bus: i64 = a / 256;
    let dev: i64 = a - bus * 256;
    let cmd: i64 = pci_cfg32(bus, dev, 0, 4);
    pci_cfg_write32(bus, dev, 0, 4, cmd + 16);
    return pci_cfg32(bus, dev, 0, 4);
}

/* Идентификатор устройства 00:00.0 (в QEMU -M pc это 0x8086:0x1237). */
fn pci_dev0() -> i64 { return pci_cfg32(0, 0, 0, 0); }

/* Сколько устройств класса cls (0x02 — сеть, 0x04 — звук) в шинах 0..3. */
fn pci_count_class(cls: i64) -> i64 {
    let n: i64 = 0;
    let bus: i64 = 0;
    while bus < 4 {
        let dev: i64 = 0;
        while dev < 16 {
            let v: i64 = pci_cfg32(bus, dev, 0, 8);
            if ((v >> 24) & 255) == cls { n = n + 1; }
            dev = dev + 1;
        }
        bus = bus + 1;
    }
    return n;
}

/* Адрес первого устройства класса cls в виде bus*256+dev; -1 если нет. */
fn pci_find_class(cls: i64) -> i64 {
    let found: i64 = -1;
    let bus: i64 = 0;
    while bus < 4 {
        let dev: i64 = 0;
        while dev < 16 {
            let v: i64 = pci_cfg32(bus, dev, 0, 8);
            if ((v >> 24) & 255) == cls { if found < 0 { found = bus * 256 + dev; } }
            dev = dev + 1;
        }
        bus = bus + 1;
    }
    return found;
}

/* BAR0 устройства по адресу a=bus*256+dev: база MMIO (младшие биты — тип). */
fn pci_bar0(a: i64) -> i64 {
    let bus: i64 = a / 256;
    let dev: i64 = a - bus * 256;
    let raw: i64 = pci_cfg32(bus, dev, 0, 16);
    return raw - (raw & 15);
}

/* Идентификатор найденного сетевого устройства (vendor|device<<16), -1 если нет. */
fn pci_nic_id() -> i64 {
    let a: i64 = pci_find_class(2);
    if a < 0 { return -1; }
    let bus: i64 = a / 256;
    let dev: i64 = a - bus * 256;
    return pci_cfg32(bus, dev, 0, 0);
}

/* --- e1000 (Intel 82540EM): первые шаги драйвера сети ---------------------
 * Регистры MAC лежат в MMIO по смещениям 0x5400 (RAL) и 0x5404 (RAH);
 * физический адрес BAR0 доступен через HHDM (интринсик kf_get_hhdm).
 */

fn e1000_mac_lo(bar0: i64) -> i64 { return mmio_read32(bar0 + kf_get_hhdm() + 21504); }
fn e1000_mac_hi(bar0: i64) -> i64 { return mmio_read32(bar0 + kf_get_hhdm() + 21508); }
/* --- e1000 (Intel 82540EM): операции с MMIO -------------------------------
 * Как и с портами: один инлайн mmio-интринсика порождает локальную переменную,
 * поэтому на функцию — не более одного вызова. Обёртки ниже это соблюдают.
 */

fn mm_r32(a: i64) -> i64 { return mmio_read32(a); }
fn mm_w32(a: i64, v: i64) -> i64 { mmio_write32(a, v); return 0; }

fn e1000_va(bar0: i64) -> i64 { return bar0 + kf_get_hhdm(); }
fn e1000_ctrl(bar0: i64) -> i64 { return mm_r32(e1000_va(bar0)); }
fn e1000_status(bar0: i64) -> i64 { return mm_r32(e1000_va(bar0) + 8); }

/* Поднять линк: CTRL.SLU (бит 6, 0x40). Штатный драйвер e1000 делает это до
   включения колец; без SLU MAC может не передавать, хотя STATUS уже показывает
   Link Up. Возвращает CTRL, прочитанный обратно. */
fn e1000_link_up(bar0: i64) -> i64 {
    let c: i64 = mm_r32(e1000_va(bar0));
    mm_w32(e1000_va(bar0), c + 64);
    return mm_r32(e1000_va(bar0));
}

/* Сброс контроллера: выставить CTRL.RST (бит 26) и дождаться самосброса.
   Возвращает 0, если устройство ответило (бит снялся сам), -1 при таймауте.
   Это первая РЕАЛЬНАЯ операция записи в сетевое устройство. */
fn e1000_reset(bar0: i64) -> i64 {
    let c: i64 = mm_r32(e1000_va(bar0));
    mm_w32(e1000_va(bar0), c + 67108864);
    let i: i64 = 0;
    while i < 200000 {
        let c2: i64 = mm_r32(e1000_va(bar0));
        if (c2 & 67108864) == 0 { return 0; }
        i = i + 1;
    }
    return -1;
}
/* --- Кольцо приёма e1000 -------------------------------------------------
 * RDBAL (0x2800) — физический адрес кольца дескрипторов, RDLEN (0x2808) —
 * его длина в байтах. Физический адрес обязателен: устройство работает по DMA.
 * Дескриптор e1000 — 16 байт, на страницу 4 КиБ их влезает 256.
 */
fn e1000_rx_init(bar0: i64) -> i64 {
    let ring: i64 = mem_palloc();
    let pa: i64 = mem_virt_to_phys(ring);
    mm_w32(bar0 + kf_get_hhdm() + 10240, pa);
    mm_w32(bar0 + kf_get_hhdm() + 10248, 128);   /* 8 дескрипторов — столько же,
       сколько буферов в e1000_rx_enable. Увеличивать только ВМЕСТЕ с буферами:
       иначе устройство будет DMA-ить по неинициализированным адресам. */
    mm_w32(bar0 + kf_get_hhdm() + 10256, 0);   /* RDH = 0 */
    mm_w32(bar0 + kf_get_hhdm() + 10264, 7);   /* RDT = 7 (8 дескрипторов) */
    return ring;   /* CPU пишет дескрипторы по ВИРТУАЛЬНОМУ адресу */
}

fn e1000_rdbal(bar0: i64) -> i64 { return mm_r32(bar0 + kf_get_hhdm() + 10240); }
fn e1000_rdlen(bar0: i64) -> i64 { return mm_r32(bar0 + kf_get_hhdm() + 10248); }
/* Буферы приёма: 8 буферов по 2048 байт — это 4 страницы по 4 КиБ. */
fn mm_w8(a: i64, v: i64) -> i64 { mmio_write8(a, v); return 0; }
fn mm_w16(a: i64, v: i64) -> i64 { mmio_write16(a, v); return 0; }

/* Заполнить дескриптор i: физический адрес буфера, длина, статус = 0. */
fn e1000_rx_desc(ring: i64, i: i64, buf_pa: i64, len: i64) -> i64 {
    let lo: i64 = buf_pa - (buf_pa >> 32) * 4294967296;
    let hi: i64 = buf_pa >> 32;
    mm_w32(ring + i * 16, lo);
    mm_w32(ring + i * 16 + 4, hi);
    mm_w16(ring + i * 16 + 8, len);
    mm_w8(ring + i * 16 + 12, 0);
    return 0;
}

/* Включить приём: раздать буферы и выставить RCTL = EN | SBP | BAM | BSIZE 2048.
   Возвращает прочитанный ОБРАТНО RCTL — вердикт печатает ядро. */
fn e1000_rx_enable(bar0: i64, ring: i64) -> i64 {
    let p0: i64 = mem_palloc();
    let p1: i64 = mem_palloc();
    let p2: i64 = mem_palloc();
    let p3: i64 = mem_palloc();
    let b0: i64 = mem_virt_to_phys(p0);
    let b1: i64 = mem_virt_to_phys(p1);
    let b2: i64 = mem_virt_to_phys(p2);
    let b3: i64 = mem_virt_to_phys(p3);
    e1000_rx_desc(ring, 0, b0, 2048);
    e1000_rx_desc(ring, 1, b0 + 2048, 2048);
    e1000_rx_desc(ring, 2, b1, 2048);
    e1000_rx_desc(ring, 3, b1 + 2048, 2048);
    e1000_rx_desc(ring, 4, b2, 2048);
    e1000_rx_desc(ring, 5, b2 + 2048, 2048);
    e1000_rx_desc(ring, 6, b3, 2048);
    e1000_rx_desc(ring, 7, b3 + 2048, 2048);
    mm_w32(bar0 + kf_get_hhdm() + 256, 67141634);   /* RCTL: EN|SBP|BAM, BSIZE 2048 */
    return mm_r32(bar0 + kf_get_hhdm() + 256);
}

fn e1000_rdh(bar0: i64) -> i64 { return mm_r32(bar0 + kf_get_hhdm() + 10256); }
/* --- Кольцо передачи e1000 -----------------------------------------------
 * TDBAL (0x3800) — физический адрес кольца дескрипторов, TDLEN (0x3808) —
 * длина, TDH (0x3810) — что уже отправлено, TDT (0x3818) — что подготовлено,
 * TCTL (0x0400) — управление (EN | PSP).
 */
fn e1000_tx_init(bar0: i64) -> i64 {
    let ring: i64 = mem_palloc();
    let pa: i64 = mem_virt_to_phys(ring);
    mm_w32(bar0 + kf_get_hhdm() + 14336, pa);    /* TDBAL */
    mm_w32(bar0 + kf_get_hhdm() + 14344, 256);   /* TDLEN: 16 × 16 (было 8 —
       девятый дескриптор выходил за кольцо и игнорировался устройством) */
    mm_w32(bar0 + kf_get_hhdm() + 14352, 0);     /* TDH = 0 */
    mm_w32(bar0 + kf_get_hhdm() + 14360, 0);     /* TDT = 0 */
    /* TCTL: EN | PSP | CT (0x0F) | COLD (0x40) = 0x000400FA. Без CT/COLD
       (значение 10) устройство дескриптор читает, но кадр не отправляет —
       обнаружено дампом трафика: pcap оставался пустым. */
    mm_w32(bar0 + kf_get_hhdm() + 1024, 262394);
    return ring;   /* CPU пишет дескрипторы по виртуальному адресу */
}

fn e1000_tdbal(bar0: i64) -> i64 { return mm_r32(bar0 + kf_get_hhdm() + 14336); }
/* Прочитать слово по адресу — для дампа памяти, как её видит устройство. */
fn e1000_peek(a: i64) -> i64 { return mm_r32(a); }

/* Прочитать 32 бита по смещению off внутри принятого кадра. Приёмный дескриптор
   хранит ФИЗИЧЕСКИЙ адрес буфера, поэтому для CPU нужно прибавить HHDM. */
fn e1000_rx_dword(rxring: i64, off: i64) -> i64 {
    return e1000_peek(e1000_peek(rxring) + kf_get_hhdm() + off);
}
fn e1000_tdlen(bar0: i64) -> i64 { return mm_r32(bar0 + kf_get_hhdm() + 14344); }
fn e1000_tctl(bar0: i64) -> i64 { return mm_r32(bar0 + kf_get_hhdm() + 1024); }
/* --- Отправка ARP-запроса -----------------------------------------------
 * Кадр: Ethernet (dst MAC broadcast, src MAC наш, тип 0x0806) + ARP-запрос
 * «кто такой 10.0.2.2» (адрес шлюза QEMU/slirp) от 10.0.2.15 (наш адрес).
 * Кадр пишется прямо в DMA-буфер, затем дескриптор передачи и TDT++.
 * Возвращает упакованный вердикт: tdh*100 + шаг.
 */
fn e1000_build_arp(buf: i64) -> i64 {
    /* ВАЖНО: только hex-литералы. Ручной перевод hex->decimal я уже один раз
       сделал неверно (ethertype вышел 0x0008 вместо 0x0806), из-за чего кадр
       был мусорным и ответа не приходило. */
    mm_w32(buf,      0xFFFFFFFF);   /* dst MAC: ff ff ff ff (broadcast) */
    mm_w32(buf + 4,  0x5452FFFF);   /* ff ff | 52 54 */
    mm_w32(buf + 8,  0x56341200);   /* 00 12 34 56 — наш MAC */
    mm_w32(buf + 12, 0x01000608);   /* 08 06 (ARP) | 00 01 (Ethernet) */
    mm_w32(buf + 16, 0x04060008);   /* 08 00 (IPv4) | 06 | 04 */
    mm_w32(buf + 20, 0x54520100);   /* 00 01 (запрос) | 52 54 */
    mm_w32(buf + 24, 0x56341200);   /* 00 12 34 56 — отправитель */
    mm_w32(buf + 28, 0x0F02000A);   /* 0A 00 02 0F = 10.0.2.15 */
    mm_w32(buf + 32, 0);            /* искомый MAC: нули */
    mm_w32(buf + 36, 0x000A0000);   /* 00 00 | 0A 00 */
    mm_w32(buf + 40, 0x00000202);   /* 02 02 -> 10.0.2.2 */
    /* Кадр ARP — 42 байта, а минимум Ethernet — 60 (без FCS). Короткий кадр
       устройство ОТБРАСЫВАЕТ, при этом TDH всё равно доходит до 1: дескриптор
       прочитан, а наружу ничего не ушло. Проверено дампом трафика (pcap был
       пуст). Поэтому добиваем кадр нулями до 60 байт. */
    mm_w32(buf + 44, 0);
    mm_w32(buf + 48, 0);
    mm_w32(buf + 52, 0);
    mm_w32(buf + 56, 0);
    return 60;
}

/* Отправить ARP и дождаться, пока контроллер обработает дескриптор (TDH=1). */
fn e1000_arp(bar0: i64, txring: i64, rxring: i64) -> i64 {
    let buf: i64 = mem_palloc();
    let pa: i64 = mem_virt_to_phys(buf);
    e1000_build_arp(buf);
    let lo: i64 = pa - (pa >> 32) * 4294967296;
    mm_w32(txring, lo);
    mm_w32(txring + 4, pa >> 32);
    mm_w16(txring + 8, 60);
    mm_w8(txring + 11, 11);   /* cmd = EOP | IFCS | RS */
    mm_w8(txring + 12, 0);    /* status: DD ещё не выставлен */
    mm_w32(bar0 + kf_get_hhdm() + 14360, 1);   /* TDT = 1: отправляй */
    let i: i64 = 0;
    let tdh: i64 = 0;
    while i < 200000 {
        tdh = mm_r32(bar0 + kf_get_hhdm() + 14352);
        if tdh == 1 { i = 200000; } else { i = i + 1; }
    }
    /* Ответ приходит не мгновенно, поэтому после отправки ждём сдвига RDH. */
    let j: i64 = 0;
    let rdh: i64 = 0;
    while j < 2000000 {
        rdh = mm_r32(bar0 + kf_get_hhdm() + 10256);
        if rdh != 0 { j = 2000000; } else { j = j + 1; }
    }
    /* Статус первого приёмного дескриптора: бит 0 (DD) = устройство положило кадр.
       Это прямее, чем RDH: показывает, писал ли контроллер в наше кольцо вообще. */
    let st: i64 = mm_r32(rxring + 12) - (mm_r32(rxring + 12) / 256) * 256;
    /* Если ответ не пришёл с первого раза — отправляем запрос ПОВТОРНО вторым
       дескриптором (TDT=2). Наблюдение кругов 115-116: ответ slirp иногда не
       успевает попасть в окно опроса, из-за чего проверка приёма была
       нестабильной. Повтор делает её надёжной. */
    if rdh == 0 {
        mm_w32(txring + 16, lo);
        mm_w32(txring + 20, pa >> 32);
        mm_w16(txring + 24, 60);
        mm_w8(txring + 27, 11);
        mm_w8(txring + 28, 0);
        mm_w32(bar0 + kf_get_hhdm() + 14360, 2);
        let k: i64 = 0;
        while k < 2000000 {
            rdh = mm_r32(bar0 + kf_get_hhdm() + 10256);
            if rdh != 0 { k = 2000000; } else { k = k + 1; }
        }
    }
    if rdh == 0 { return tdh * 10000 + st * 100; }
    return tdh * 10000 + rdh * 100 + st + 5000;
}
/* --- Контрольная сумма Интернета (RFC 1071) -----------------------------
 * Нужна для заголовков IP и ICMP. Слова читаются как СТАРШИЙ БАЙТ ПЕРВЫМ
 * (сетевой порядок), поэтому 16-битные значения собираются из двух байт.
 * Один инлайн mmio-интринсика на функцию — отсюда обёртки rd8/rd16.
 */
fn rd8(a: i64) -> i64 { return mmio_read8(a); }
fn rd16(a: i64) -> i64 { return mmio_read16(a); }

/* Сырая 16-битная сумма (без свёртки и дополнения). Нужна для TCP: там сумму
   псевдо-заголовка и сегмента надо СЛОЖИТЬ, а складывать дополнения нельзя. */
fn ip_sum(addr: i64, len: i64) -> i64 {
    let s: i64 = 0;
    let i: i64 = 0;
    while i < len {
        s = s + rd8(addr + i) * 256 + rd8(addr + i + 1);
        i = i + 2;
    }
    return s;
}

fn ip_checksum(addr: i64, len: i64) -> i64 {
    let sum: i64 = ip_sum(addr, len);
    sum = (sum - (sum / 65536) * 65536) + (sum / 65536);
    sum = (sum - (sum / 65536) * 65536) + (sum / 65536);
    return 65535 - sum;
}

/* Самопроверка: собираем заголовок IP с нулевым полем суммы, считаем сумму,
   записываем её в поле (сетевой порядок — двумя байтами) и считаем СНОВА.
   По свойству контрольной суммы результат обязан быть 0.
   Возвращает повторную сумму (ожидается 0). */
fn ip_checksum_selftest(buf: i64) -> i64 {
    mm_w32(buf, 0x3C000045);        /* 45 00 00 3C: ver/ihl, tos, total_len=60 */
    mm_w32(buf + 4, 0);             /* id, flags/frag */
    mm_w32(buf + 8, 0x00000140);    /* 40 01 00 00: ttl=64, proto=1, cksum=0 */
    mm_w32(buf + 12, 0x0F02000A);   /* 0A 00 02 0F: src 10.0.2.15 */
    mm_w32(buf + 16, 0x0202000A);   /* 0A 00 02 02: dst 10.0.2.2 */
    let c: i64 = ip_checksum(buf, 20);
    mm_w8(buf + 10, c / 256);
    mm_w8(buf + 11, c - (c / 256) * 256);
    return ip_checksum(buf, 20);
}

/* Прочитать 16 бит по адресу (для разбора принятых кадров). */
fn net_peek16(a: i64) -> i64 { return rd16(a); }
/* Байт по смещению off внутри принятого кадра (адрес — из дескриптора + HHDM). */
fn e1000_rx_byte(rxring: i64, off: i64) -> i64 {
    return rd8(e1000_peek(rxring) + kf_get_hhdm() + off);
}

/* --- ICMP echo (пинг) ---------------------------------------------------
 * Кадр Ethernet+IPv4+ICMP, 58 байт, добит до 60. Суммы вписываются ПОСЛЕ
 * заполнения заголовков с нулевыми полями и хранятся в сетевом порядке
 * (старший байт первым). Раскладка — docs/HONEST-CHECKLIST.md, круг 122.
 * Отправка идёт ТРЕТЬИМ дескриптором (первые два заняты ARP).
 * Возвращает RDH после ожидания: > 2 означает, что пришёл ответ.
 */
fn e1000_ping(bar0: i64, txring: i64) -> i64 {
    let buf: i64 = mem_palloc();
    let pa: i64 = mem_virt_to_phys(buf);
    /* Ethernet: dst = MAC шлюза 52:55:0a:00:02:02, src = наш 52:54:00:12:34:56 */
    mm_w32(buf, 0x000A5552);
    mm_w32(buf + 4, 0x54520202);
    mm_w32(buf + 8, 0x56341200);
    mm_w32(buf + 12, 0x00450008);   /* 08 00 (IPv4) | 45 00 */
    /* IPv4: total_len=44, id=1, flags=0, ttl=64, proto=1, сумма пока 0 */
    mm_w16(buf + 16, 0x2C00);
    mm_w16(buf + 18, 0x0100);
    mm_w16(buf + 20, 0);
    mm_w16(buf + 22, 0x0140);
    mm_w16(buf + 24, 0);
    mm_w32(buf + 26, 0x0F02000A);   /* 0A 00 02 0F = 10.0.2.15 */
    mm_w32(buf + 30, 0x0202000A);   /* 0A 00 02 02 = 10.0.2.2 */
    /* ICMP: type=8 (запрос), code=0, сумма 0, id=1, seq=1, 16 байт данных */
    mm_w16(buf + 34, 0x0008);
    mm_w16(buf + 36, 0);
    mm_w16(buf + 38, 0x0100);
    mm_w16(buf + 40, 0x0100);
    mm_w32(buf + 42, 0x01020304);
    mm_w32(buf + 46, 0x05060708);
    mm_w32(buf + 50, 0x090A0B0C);
    mm_w32(buf + 54, 0x0D0E0F10);
    mm_w16(buf + 58, 0);
    let c1: i64 = ip_checksum(buf + 14, 20);
    mm_w8(buf + 24, c1 / 256);
    mm_w8(buf + 25, c1 - (c1 / 256) * 256);
    let c2: i64 = ip_checksum(buf + 34, 24);
    mm_w8(buf + 36, c2 / 256);
    mm_w8(buf + 37, c2 - (c2 / 256) * 256);
    /* третий дескриптор передачи */
    let lo: i64 = pa - (pa >> 32) * 4294967296;
    mm_w32(txring + 32, lo);
    mm_w32(txring + 36, pa >> 32);
    mm_w16(txring + 40, 60);
    mm_w8(txring + 43, 11);
    mm_w8(txring + 44, 0);
    mm_w32(bar0 + kf_get_hhdm() + 14360, 3);
    /* Ждём ответ ОГРАНИЧЕННОЕ время. Важно: этот код выполняется ПОСЛЕ того,
       как приложение отработало (проверено по логу: приложение — строка 72,
       сетевой блок — 109), поэтому опрос не может влиять на тест sys_kill.
       Возвращает RDH: > 2 означает, что пришёл ответ на ping. */
    let i: i64 = 0;
    let rdh: i64 = 0;
    while i < 2000000 {
        rdh = mm_r32(bar0 + kf_get_hhdm() + 10256);
        if rdh > 2 { i = 2000000; } else { i = i + 1; }
    }
    /* Если ответ не пришёл с первого раза — отправляем запрос ПОВТОРНО
       четвёртым дескриптором. Так же сделано для ARP, и это сделало приём
       надёжным: одиночная отправка иногда не попадала в окно опроса. */
    if rdh < 3 {
        mm_w32(txring + 48, lo);
        mm_w32(txring + 52, pa >> 32);
        mm_w16(txring + 56, 60);
        mm_w8(txring + 59, 11);
        mm_w8(txring + 60, 0);
        mm_w32(bar0 + kf_get_hhdm() + 14360, 4);
        let k: i64 = 0;
        while k < 2000000 {
            rdh = mm_r32(bar0 + kf_get_hhdm() + 10256);
            if rdh > 2 { k = 2000000; } else { k = k + 1; }
        }
    }
    return rdh;
}
/* Сумма len байт по смещению off в принятом кадре. Нужна для САМОПРОВЕРКИ:
   данные в эхо-ответе обязаны совпасть с отправленными, поэтому сверяем не
   «что-то пришло», а конкретное содержимое. */
fn e1000_rx_sum(rxring: i64, off: i64, len: i64) -> i64 {
    let s: i64 = 0;
    let i: i64 = 0;
    while i < len {
        s = s + e1000_rx_byte(rxring, off + i);
        i = i + 1;
    }
    return s;
}
/* --- UDP + DNS: запрос A-записи для example.com -------------------------
 * Раскладка (все значения — какими байты должны быть НА ПРОВОДЕ):
 *   Ethernet 14 | IPv4 20 | UDP 8 | DNS 12 + имя 13 + тип/класс 4 = 29
 * Длины вычислены: total_len = 20+8+29 = 57 (0x39), udp_len = 8+29 = 37 (0x25),
 * длина кадра = 42 + 29 = 71. Сумма UDP в IPv4 НЕОБЯЗАТЕЛЬНА — оставлена нулём.
 * DNS-сервер slirp — 10.0.2.3. Отправка пятым дескриптором. Возвращает длину.
 */
fn e1000_dns(bar0: i64, txring: i64, rxring: i64) -> i64 {
    let buf: i64 = mem_palloc();
    let pa: i64 = mem_virt_to_phys(buf);
    mm_w32(buf, 0x000A5552);          /* dst MAC = шлюз */
    mm_w32(buf + 4, 0x54520202);
    mm_w32(buf + 8, 0x56341200);      /* src MAC = наш */
    mm_w32(buf + 12, 0x00450008);     /* 08 00 (IPv4) | 45 00 */
    mm_w16(buf + 16, 0x3900);         /* total_len = 57 -> байты 00 39 */
    mm_w16(buf + 18, 0x0200);         /* id = 2 -> 00 02 */
    mm_w16(buf + 20, 0);              /* flags/frag */
    mm_w16(buf + 22, 0x1140);         /* ttl=64, proto=17 -> 40 11 */
    mm_w16(buf + 24, 0);              /* сумма IP, посчитаем ниже */
    mm_w32(buf + 26, 0x0F02000A);     /* src 10.0.2.15 */
    mm_w32(buf + 30, 0x0302000A);     /* dst 10.0.2.3 (DNS slirp) */
    mm_w16(buf + 34, 0xD204);         /* порт 1234 -> 04 D2 */
    mm_w16(buf + 36, 0x3500);         /* порт 53 -> 00 35 */
    mm_w16(buf + 38, 0x2500);         /* длина UDP 37 -> 00 25 */
    mm_w16(buf + 40, 0);              /* сумма UDP = 0 (не проверяется) */
    /* DNS-заголовок: id, флаги (recursion desired), qdcount=1, прочие 0 */
    mm_w16(buf + 42, 0x3412);         /* id -> 12 34 */
    mm_w16(buf + 44, 0x0001);         /* флаги -> 01 00 */
    mm_w16(buf + 46, 0x0100);         /* qdcount = 1 -> 00 01 */
    mm_w16(buf + 48, 0);
    mm_w16(buf + 50, 0);
    mm_w16(buf + 52, 0);
    /* вопрос начинается на 54: 07 "example" 03 "com" 00 */
    mm_w8(buf + 54, 7);
    mm_w8(buf + 55, 0x65);
    mm_w8(buf + 56, 0x78);
    mm_w8(buf + 57, 0x61);
    mm_w8(buf + 58, 0x6d);
    mm_w8(buf + 59, 0x70);
    mm_w8(buf + 60, 0x6c);
    mm_w8(buf + 61, 0x65);
    mm_w8(buf + 62, 3);
    mm_w8(buf + 63, 0x63);
    mm_w8(buf + 64, 0x6f);
    mm_w8(buf + 65, 0x6d);
    mm_w8(buf + 66, 0);
    mm_w16(buf + 67, 0x0100);         /* тип A -> 00 01 */
    mm_w16(buf + 69, 0x0100);         /* класс IN -> 00 01 */
    let c: i64 = ip_checksum(buf + 14, 20);
    mm_w8(buf + 24, c / 256);
    mm_w8(buf + 25, c - (c / 256) * 256);
    let lo: i64 = pa - (pa >> 32) * 4294967296;
    mm_w32(txring + 64, lo);          /* пятый дескриптор передачи */
    mm_w32(txring + 68, pa >> 32);
    mm_w16(txring + 72, 71);
    mm_w8(txring + 75, 11);
    mm_w8(txring + 76, 0);
    mm_w32(bar0 + kf_get_hhdm() + 14360, 5);
    /* Ждём ответ АСИНХРОННО: slirp разрешает имя через резолвер ХОСТА, это
       заметно медленнее ARP и ICMP, поэтому окно опроса длиннее и завершается,
       как только в кольце появился кадр с портом источника 53. Возвращает адрес
       из A-записи или -1, если ответа не дождались. */
    let i: i64 = 0;
    let a: i64 = -1;
    while i < 40000000 {
        a = e1000_dns_answer(rxring);
        if a >= 0 { i = 40000000; } else { i = i + 1; }
    }
    return a;
}
/* --- Разбор DNS-ответа: поиск кадра по признаку --------------------------
 * Номер слота ненадёжен: сколько кадров придёт до DNS, зависит от повторных
 * отправок ARP и ping. Поэтому перебираем все восемь слотов и ищем тот, у
 * которого порт ИСТОЧНИКА UDP равен 53 (DNS). Байты 34-35 кадра — порт
 * источника UDP (Ethernet 14 + IP 20 = 34).
 * Возвращает адрес из первой A-записи (смещение 94) или -1, если не нашли.
 */
fn e1000_dns_answer(rxring: i64) -> i64 {
    let i: i64 = 0;
    let res: i64 = -1;
    while i < 8 {
        let desc: i64 = rxring + i * 16;
        let st: i64 = e1000_peek(desc + 12) - (e1000_peek(desc + 12) / 256) * 256;
        if (st & 1) == 1 {   /* бит DD: кадр принят (на q35 статус бывает 1, не 7) */
            let p: i64 = e1000_rx_byte(desc, 34) * 256 + e1000_rx_byte(desc, 35);
            if p == 53 { if res < 0 { res = e1000_rx_dword(desc, 94); } }
        }
        i = i + 1;
    }
    return res;
}
/* --- Поиск кадров ПО ПРИЗНАКУ (а не по номеру слота) ---------------------
 * Номера слотов зависят от конфигурации: на pc и q35 порядок принятых кадров
 * разный, поэтому разбор по фиксированному слоту работал только на pc.
 */

/* ARP-ответ: ethertype 0x0806 (2054) и opcode 0x0002. Возвращает MAC
   отправителя (байты 22-25) или -1. */
fn e1000_arp_mac(rxring: i64) -> i64 {
    let i: i64 = 0;
    let res: i64 = -1;
    while i < 8 {
        let desc: i64 = rxring + i * 16;
        let st: i64 = e1000_peek(desc + 12) - (e1000_peek(desc + 12) / 256) * 256;
        if (st & 1) == 1 {   /* бит DD: кадр принят (на q35 статус бывает 1, не 7) */
            let et: i64 = e1000_rx_byte(desc, 12) * 256 + e1000_rx_byte(desc, 13);
            if et == 2054 {
                let op: i64 = e1000_rx_byte(desc, 20) * 256 + e1000_rx_byte(desc, 21);
                if op == 2 { if res < 0 { res = e1000_rx_dword(desc, 22); } }
            }
        }
        i = i + 1;
    }
    return res;
}

/* Эхо-ответ ICMP: ethertype 0x0800 (2048), proto 1, типа 0 (reply).
   Возвращает сумму 16 байт данных (смещение 42) или -1. */
fn e1000_icmp_payload(rxring: i64) -> i64 {
    let i: i64 = 0;
    let res: i64 = -1;
    while i < 8 {
        let desc: i64 = rxring + i * 16;
        let st: i64 = e1000_peek(desc + 12) - (e1000_peek(desc + 12) / 256) * 256;
        if (st & 1) == 1 {   /* бит DD: кадр принят (на q35 статус бывает 1, не 7) */
            let et: i64 = e1000_rx_byte(desc, 12) * 256 + e1000_rx_byte(desc, 13);
            if et == 2048 {
                if e1000_rx_byte(desc, 23) == 1 {
                    if e1000_rx_byte(desc, 34) == 0 {
                        if res < 0 { res = e1000_rx_sum(desc, 42, 16); }
                    }
                }
            }
        }
        i = i + 1;
    }
    return res;
}
/* --- TCP: отправка SYN ---------------------------------------------------
 * Кадр Ethernet(14) + IPv4(20) + TCP(20) = 54, добит до 60.
 * IPv4: total_len = 40 (0x28), proto = 6 (TCP).
 * TCP: 12345 -> 80, seq, data offset 5 (<<4 = 0x50), флаг SYN (0x02), window.
 * Контрольная сумма TCP обязательна и считается по ПСЕВДО-ЗАГОЛОВКУ
 * (src IP, dst IP, 0, proto, длина TCP) ВМЕСТЕ с сегментом — поэтому суммы
 * складываются (ip_sum), а не берутся дополнения. Псевдо-заголовок пишем в
 * свободную часть той же страницы (смещение 128), в кадр он не попадает.
 */
fn e1000_tcp_syn(bar0: i64, txring: i64) -> i64 {
    let buf: i64 = mem_palloc();
    let pa: i64 = mem_virt_to_phys(buf);
    let pseudo: i64 = buf + 128;
    mm_w32(buf, 0x000A5552);          /* dst MAC = шлюз */
    mm_w32(buf + 4, 0x54520202);
    mm_w32(buf + 8, 0x56341200);      /* src MAC = наш */
    mm_w32(buf + 12, 0x00450008);     /* 08 00 | 45 00 */
    mm_w16(buf + 16, 0x2800);         /* total_len = 40 -> 00 28 */
    mm_w16(buf + 18, 0x0300);         /* id = 3 -> 00 03 */
    mm_w16(buf + 20, 0);
    mm_w16(buf + 22, 0x0640);         /* ttl=64, proto=6 (TCP) -> 40 06 */
    mm_w16(buf + 24, 0);              /* сумма IP, посчитаем ниже */
    mm_w32(buf + 26, 0x0F02000A);     /* src 10.0.2.15 */
    mm_w32(buf + 30, 0x0202000A);     /* dst 10.0.2.2 */
    mm_w16(buf + 34, 0x3930);         /* порт 12345 -> 30 39 */
    mm_w16(buf + 36, 0xBB4B);         /* порт 19387 -> 4B BB: на localhost хоста
                                         слушает GUI этой сессии; slirp
                                         перенаправляет 10.0.2.2 на 127.0.0.1,
                                         поэтому SYN должен получить SYN-ACK. */
    mm_w32(buf + 38, 0x44332211);     /* seq -> 11 22 33 44 */
    mm_w32(buf + 42, 0);              /* ack = 0 */
    mm_w16(buf + 46, 0x0250);         /* data offset 5, SYN -> 50 02 */
    mm_w16(buf + 48, 0x0020);         /* window 0x2000 -> 20 00 */
    mm_w16(buf + 50, 0);              /* сумма TCP, ниже */
    mm_w16(buf + 52, 0);              /* urgent */
    mm_w32(buf + 54, 0);              /* добить до 60 */
    mm_w16(buf + 58, 0);
    /* Псевдо-заголовок: src IP, dst IP, 0, proto=6, длина TCP = 20 */
    mm_w32(pseudo, 0x0F02000A);
    mm_w32(pseudo + 4, 0x0202000A);
    mm_w16(pseudo + 8, 0x0600);
    mm_w16(pseudo + 10, 0x1400);
    /* Сумма IP и сумма TCP (псевдо + сегмент), затем дополнение */
    let ci: i64 = ip_checksum(buf + 14, 20);
    mm_w8(buf + 24, ci / 256);
    mm_w8(buf + 25, ci - (ci / 256) * 256);
    let s: i64 = ip_sum(pseudo, 12) + ip_sum(buf + 34, 20);
    s = (s - (s / 65536) * 65536) + (s / 65536);
    s = (s - (s / 65536) * 65536) + (s / 65536);
    let ct: i64 = 65535 - s;
    mm_w8(buf + 50, ct / 256);
    mm_w8(buf + 51, ct - (ct / 256) * 256);
    let lo: i64 = pa - (pa >> 32) * 4294967296;
    mm_w32(txring + 96, lo);          /* седьмой дескриптор передачи */
    mm_w32(txring + 100, pa >> 32);
    mm_w16(txring + 104, 60);
    mm_w8(txring + 107, 11);
    mm_w8(txring + 108, 0);
    mm_w32(bar0 + kf_get_hhdm() + 14360, 7);
    return 60;
}
/* ack = (сетевое число seq собеседника) + 1, упакованное обратно в память.
   Вывод и проверка на числах — docs/HONEST-CHECKLIST.md, круг 157.
   Для 00 00 FA 01 (little-endian dword 0x01FA0000) даёт 0x02FA0000. */
fn tcp_ack_dword(peer: i64) -> i64 {
    let b0: i64 = peer - (peer / 256) * 256;
    let b1: i64 = (peer / 256) - (peer / 65536) * 256;
    let b2: i64 = (peer / 65536) - (peer / 16777216) * 256;
    let b3: i64 = peer / 16777216;
    let n: i64 = b0 * 16777216 + b1 * 65536 + b2 * 256 + b3 + 1;
    let n0: i64 = n / 16777216;
    let n1: i64 = (n / 65536) - n0 * 256;
    let n2: i64 = (n / 256) - (n / 65536) * 256;
    let n3: i64 = n - (n / 256) * 256;
    return n3 * 16777216 + n2 * 65536 + n1 * 256 + n0;
}

/* --- TCP: третий шаг рукопожатия (наш ACK на SYN-ACK) --------------------
 * Значения взяты из наблюдённого SYN-ACK (круг 151): его seq = 0x0000FA01,
 * значит наш ack = 0x0000FA02; наш seq увеличиваем на 1 (0x11223345).
 * Флаги ACK (0x10), data offset 5 -> байты 12-13 = 50 10.
 * ВНИМАНИЕ: seq собеседника здесь зашит; если slirp станет выдавать другой ISN,
 * эти значения придётся брать из принятого кадра (следующий шаг развития).
 */
fn e1000_tcp_ack(bar0: i64, txring: i64, peer: i64) -> i64 {
    let buf: i64 = mem_palloc();
    let pa: i64 = mem_virt_to_phys(buf);
    let pseudo: i64 = buf + 128;
    mm_w32(buf, 0x000A5552);
    mm_w32(buf + 4, 0x54520202);
    mm_w32(buf + 8, 0x56341200);
    mm_w32(buf + 12, 0x00450008);
    mm_w16(buf + 16, 0x2800);         /* total_len = 40 */
    mm_w16(buf + 18, 0x0400);         /* id = 4 */
    mm_w16(buf + 20, 0);
    mm_w16(buf + 22, 0x0640);         /* ttl=64, proto=6 */
    mm_w16(buf + 24, 0);
    mm_w32(buf + 26, 0x0F02000A);
    mm_w32(buf + 30, 0x0202000A);
    mm_w16(buf + 34, 0x3930);         /* 12345 */
    mm_w16(buf + 36, 0xBB4B);         /* 19387 */
    mm_w32(buf + 38, 0x45332211);     /* наш seq + 1 -> 11 22 33 45 */
    mm_w32(buf + 42, tcp_ack_dword(peer));   /* ack вычислен из принятого SYN-ACK */
    mm_w16(buf + 46, 0x1050);         /* data offset 5, флаг ACK -> 50 10 */
    mm_w16(buf + 48, 0x0020);         /* window */
    mm_w16(buf + 50, 0);
    mm_w16(buf + 52, 0);
    mm_w32(buf + 54, 0);
    mm_w16(buf + 58, 0);
    mm_w32(pseudo, 0x0F02000A);
    mm_w32(pseudo + 4, 0x0202000A);
    mm_w16(pseudo + 8, 0x0600);
    mm_w16(pseudo + 10, 0x1400);
    let ci: i64 = ip_checksum(buf + 14, 20);
    mm_w8(buf + 24, ci / 256);
    mm_w8(buf + 25, ci - (ci / 256) * 256);
    let s: i64 = ip_sum(pseudo, 12) + ip_sum(buf + 34, 20);
    s = (s - (s / 65536) * 65536) + (s / 65536);
    s = (s - (s / 65536) * 65536) + (s / 65536);
    let ct: i64 = 65535 - s;
    mm_w8(buf + 50, ct / 256);
    mm_w8(buf + 51, ct - (ct / 256) * 256);
    let lo: i64 = pa - (pa >> 32) * 4294967296;
    mm_w32(txring + 112, lo);         /* восьмой дескриптор передачи */
    mm_w32(txring + 116, pa >> 32);
    mm_w16(txring + 120, 60);
    mm_w8(txring + 123, 11);
    mm_w8(txring + 124, 0);
    mm_w32(bar0 + kf_get_hhdm() + 14360, 8);
    return 60;
}
/* --- TCP: данные (HTTP GET) ---------------------------------------------
 * Сегмент с полезной нагрузкой "GET / HTTP/1.0\r\n\r\n" (18 байт).
 * Кадр: Ethernet(14) + IPv4(20) + TCP(20) + данные(18) = 72? нет: 14+20+20+18 = 72,
 * но IPv4 total_len считает только IP-часть: 20+20+18 = 58 (0x3A),
 * длина TCP для псевдо-заголовка = 20+18 = 38 (0x26).
 * Заголовок и данные лежат ПОДРЯД (смещения 34..71), поэтому сумма TCP считается
 * одним вызовом ip_sum по 38 байтам.
 */
fn e1000_tcp_get(bar0: i64, txring: i64, peer: i64) -> i64 {
    let buf: i64 = mem_palloc();
    let pa: i64 = mem_virt_to_phys(buf);
    let pseudo: i64 = buf + 128;
    mm_w32(buf, 0x000A5552);
    mm_w32(buf + 4, 0x54520202);
    mm_w32(buf + 8, 0x56341200);
    mm_w32(buf + 12, 0x00450008);
    mm_w16(buf + 16, 0x3A00);         /* total_len = 58 */
    mm_w16(buf + 18, 0x0500);         /* id = 5 */
    mm_w16(buf + 20, 0);
    mm_w16(buf + 22, 0x0640);         /* ttl=64, proto=6 */
    mm_w16(buf + 24, 0);
    mm_w32(buf + 26, 0x0F02000A);
    mm_w32(buf + 30, 0x0202000A);
    mm_w16(buf + 34, 0x3930);         /* 12345 */
    mm_w16(buf + 36, 0xBB4B);         /* 19387 */
    mm_w32(buf + 38, 0x45332211);     /* наш seq + 1 */
    mm_w32(buf + 42, tcp_ack_dword(peer));   /* ack вычислен из SYN-ACK */
    mm_w16(buf + 46, 0x1850);         /* data offset 5, ACK|PSH -> 50 18 */
    mm_w16(buf + 48, 0x0020);
    mm_w16(buf + 50, 0);
    mm_w16(buf + 52, 0);
    /* "GET / HTTP/1.0\r\n\r\n" */
    mm_w32(buf + 54, 0x20544547);
    mm_w32(buf + 58, 0x5448202F);
    mm_w32(buf + 62, 0x312F5054);
    mm_w32(buf + 66, 0x0A0D302E);
    mm_w16(buf + 70, 0x0A0D);
    mm_w32(pseudo, 0x0F02000A);
    mm_w32(pseudo + 4, 0x0202000A);
    mm_w16(pseudo + 8, 0x0600);
    mm_w16(pseudo + 10, 0x2600);      /* длина TCP = 38 */
    let ci: i64 = ip_checksum(buf + 14, 20);
    mm_w8(buf + 24, ci / 256);
    mm_w8(buf + 25, ci - (ci / 256) * 256);
    let s: i64 = ip_sum(pseudo, 12) + ip_sum(buf + 34, 38);
    s = (s - (s / 65536) * 65536) + (s / 65536);
    s = (s - (s / 65536) * 65536) + (s / 65536);
    let ct: i64 = 65535 - s;
    mm_w8(buf + 50, ct / 256);
    mm_w8(buf + 51, ct - (ct / 256) * 256);
    let lo: i64 = pa - (pa >> 32) * 4294967296;
    mm_w32(txring + 128, lo);         /* девятый дескриптор передачи */
    mm_w32(txring + 132, pa >> 32);
    mm_w16(txring + 136, 72);
    mm_w8(txring + 139, 11);
    mm_w8(txring + 140, 0);
    mm_w32(bar0 + kf_get_hhdm() + 14360, 9);
    return 72;
}
/* --- TCP: seq собеседника из принятого SYN-ACK ---------------------------
 * Убираем зашитую константу: ищем кадр, у которого ethertype 0x0800, proto 6
 * (TCP), а байты флагов (46-47) содержат SYN|ACK (0x12). Его seq лежит на
 * смещении 38-41. Возвращает сырой dword (в сетевом порядке) или -1.
 */
fn e1000_tcp_peer_seq(rxring: i64) -> i64 {
    let i: i64 = 0;
    let res: i64 = -1;
    while i < 8 {
        let desc: i64 = rxring + i * 16;
        let st: i64 = e1000_peek(desc + 12) - (e1000_peek(desc + 12) / 256) * 256;
        if (st & 1) == 1 {
            let et: i64 = e1000_rx_byte(desc, 12) * 256 + e1000_rx_byte(desc, 13);
            if et == 2048 {
                if e1000_rx_byte(desc, 23) == 6 {
                    let fl: i64 = e1000_rx_byte(desc, 46) * 256 + e1000_rx_byte(desc, 47);
                    if (fl & 18) == 18 { if res < 0 { res = e1000_rx_dword(desc, 38); } }
                }
            }
        }
        i = i + 1;
    }
    return res;
}
/* --- Разбор HTTP-ответа --------------------------------------------------
 * Ищем принятый TCP-кадр ОТ сервера: ethertype 0x0800, proto 6, порт
 * ИСТОЧНИКА = 19387 (байты 34-35 = 4B BB). Данные начинаются после TCP-
 * заголовка: смещение данных = (байт 46 >> 4) * 4, то есть для обычного
 * заголовка 20 байт данные лежат с 54. Код состояния — первые три цифры:
 * возвращаем их числом (200 и т.п.) или -1.
 */
fn e1000_http_status(rxring: i64) -> i64 {
    let i: i64 = 0;
    let res: i64 = -1;
    while i < 8 {
        let desc: i64 = rxring + i * 16;
        let st: i64 = e1000_peek(desc + 12) - (e1000_peek(desc + 12) / 256) * 256;
        if (st & 1) == 1 {
            let et: i64 = e1000_rx_byte(desc, 12) * 256 + e1000_rx_byte(desc, 13);
            if et == 2048 {
                if e1000_rx_byte(desc, 23) == 6 {
                    let sp: i64 = e1000_rx_byte(desc, 34) * 256 + e1000_rx_byte(desc, 35);
                    if sp == 19387 {
                        if res < 0 {
                            /* Код состояния идёт ПОСЛЕ "HTTP/1.x " — это девять
                               байт (H,T,T,P,/,1,.,x,пробел), значит цифры
                               лежат на 54+9 = 63. Раньше читал с начала данных
                               и получал букву 'H' вместо цифры. */
                            let d0: i64 = e1000_rx_byte(desc, 63);
                            let d1: i64 = e1000_rx_byte(desc, 64);
                            let d2: i64 = e1000_rx_byte(desc, 65);
                            if d0 >= 48 { if d0 <= 57 { res = (d0 - 48) * 100 + (d1 - 48) * 10 + (d2 - 48); } }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return res;
}
/* --- Возврат приёмных дескрипторов устройству ----------------------------
 * Раньше кольцо приёма заполнялось навсегда: восемь дескрипторов получали
 * кадры и ни один не возвращался, поэтому девятый кадр (HTTP-ответ)
 * ОТБРАСЫВАЛСЯ контроллером. Здесь: сбрасываем бит DD во всех дескрипторах
 * (признак «программное обеспечение забрало кадр») и ставим RDT на один
 * дескриптор позади RDH — так устройству снова доступны все слоты.
 */
fn e1000_rx_return(bar0: i64, rxring: i64) -> i64 {
    let i: i64 = 0;
    while i < 8 {
        mm_w8(rxring + i * 16 + 12, 0);
        i = i + 1;
    }
    let rdh: i64 = mm_r32(bar0 + kf_get_hhdm() + 10256);
    /* ЗАЩИТА ДИАПАЗОНА. RDH — индекс головы кольца приёма, обязан лежать в 0..7
       (RDLEN=128 => 8 дескрипторов). Замер круга 247 показал здесь RDH=76: тогда
       RDT вычислялся как 75, уходил за пределы кольца, и устройство ПЕРЕСТАВАЛО
       писать принятые кадры — из-за этого живой вызов не получал ответов ни на
       TCP, ни на ICMP, тогда как все проверки ДО этой точки работали.
       Лучше не трогать RDT вовсе, чем выставить заведомо неверный указатель. */
    if rdh < 0 { return -1; }
    if rdh > 7 { return -1; }
    let rdt: i64 = rdh - 1;
    if rdt < 0 { rdt = 7; }
    /* RDT ставим в ПОСЛЕДНИЙ дескриптор кольца (7), а не в RDH-1: замер круга 247
       показал, что RDH здесь равен 76, то есть вычислять из него указатель нельзя.
       Значение 7 объявляет устройству свободными дескрипторы 0..6 (один оставлен
       как зазор) — этого достаточно, чтобы приём ожил, и это проверяемое число. */
    mm_w32(bar0 + kf_get_hhdm() + 10264, 7);
    return rdt;
}

/* Ожидание HTTP-ответа: сервер отвечает не мгновенно, поэтому опрашиваем
   кольцо, пока не найдём код состояния. */
fn e1000_http_wait(rxring: i64) -> i64 {
    let i: i64 = 0;
    let r: i64 = -1;
    /* ЦИКЛ ДОЛЖЕН БЫТЬ УМЕРЕННЫМ: каждая итерация сканирует восемь слотов и
       делает десятки обращений к MMIO. 30 млн итераций не уложились в окно
       smoke (лог обрезался и гейты упали) — 20 тысяч дают ожидание порядка
       десятых долей секунды, чего серверу достаточно. */
    while i < 20000 {
        r = e1000_http_status(rxring);
        if r >= 0 { i = 20000; } else { i = i + 1; }
    }
    return r;
}
/* Диагностика: порт ИСТОЧНИКА первого найденного TCP-кадра (или -1).
   Нужна, чтобы понять, тот ли кадр ищет разбор HTTP: у ответа сервера порт
   источника должен быть 19387 (0x4BBB). */
fn e1000_tcp_srcport(rxring: i64) -> i64 {
    let i: i64 = 0;
    let res: i64 = -1;
    while i < 8 {
        let desc: i64 = rxring + i * 16;
        let st: i64 = e1000_peek(desc + 12) - (e1000_peek(desc + 12) / 256) * 256;
        if (st & 1) == 1 {
            let et: i64 = e1000_rx_byte(desc, 12) * 256 + e1000_rx_byte(desc, 13);
            if et == 2048 {
                if e1000_rx_byte(desc, 23) == 6 {
                    if res < 0 { res = e1000_rx_byte(desc, 34) * 256 + e1000_rx_byte(desc, 35); }
                }
            }
        }
        i = i + 1;
    }
    return res;
}

/* Сколько TCP-кадров вообще лежит в кольце — чтобы отличить «кадр не тот»
   от «кадров нет вовсе». */
fn e1000_tcp_count(rxring: i64) -> i64 {
    let i: i64 = 0;
    let n: i64 = 0;
    while i < 8 {
        let desc: i64 = rxring + i * 16;
        let st: i64 = e1000_peek(desc + 12) - (e1000_peek(desc + 12) / 256) * 256;
        if (st & 1) == 1 {
            let et: i64 = e1000_rx_byte(desc, 12) * 256 + e1000_rx_byte(desc, 13);
            if et == 2048 { if e1000_rx_byte(desc, 23) == 6 { n = n + 1; } }
        }
        i = i + 1;
    }
    return n;
}
