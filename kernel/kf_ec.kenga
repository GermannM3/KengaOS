/* kf_ec.kenga — ACPI Embedded Controller (EC) на языке Kenga.
 *
 * Зачем: EC — это микроконтроллер на большинстве ноутбуков, через который
 * доступны батарея (заряд, напряжение, статус), температуры и вентиляторы.
 * В QEMU EC тоже есть, поэтому драйвер проверяем без железа.
 *
 * Протокол (стандартный ACPI EC, порты ввода-вывода):
 *   0x66 — командный/статусный регистр (SC): бит 1 = IBF (вход занят),
 *                                             бит 0 = OBF (выход готов)
 *   0x62 — регистр данных (DATA)
 *
 * Чтение регистра EC (команда RD_EC = 0x80):
 *   1) дождаться IBF=0
 *   2) outb(0x66, 0x80)
 *   3) дождаться IBF=0
 *   4) outb(0x62, addr)
 *   5) дождаться OBF=1
 *   6) результат = inb(0x62)
 *
 * Логика целиком на Kenga: порты трогаются через два интринсика
 * asm_inb/asm_outb (те же, которыми kmain.kenga инициализирует COM1).
 */

@intrinsic fn asm_inb(p: i64) -> i64;
@intrinsic fn asm_outb(p: i64, v: i64);

/* Ждать, пока контроллер примет команду (IBF=0). 0 — можно писать, -1 — таймаут. */
fn ec_wait_ibf() -> i64 {
    let i: i64 = 0;
    while i < 100000 {
        if (asm_inb(0x66) & 2) == 0 { return 0; }
        i = i + 1;
    }
    return -1;
}

/* Ждать готовности данных (OBF=1). 0 — данные есть, -1 — таймаут. */
fn ec_wait_obf() -> i64 {
    let i: i64 = 0;
    while i < 100000 {
        if (asm_inb(0x66) & 1) == 1 { return 0; }
        i = i + 1;
    }
    return -1;
}

/* Прочитать регистр EC по адресу addr. -1 — EC не отвечает. */
fn ec_read(addr: i64) -> i64 {
    if ec_wait_ibf() != 0 { return -1; }
    asm_outb(0x66, 0x80);
    if ec_wait_ibf() != 0 { return -1; }
    asm_outb(0x62, addr);
    if ec_wait_obf() != 0 { return -1; }
    return asm_inb(0x62);
}

/* Зонд: сколько регистров подряд прочитались. Гейт в CI опирается на это число:
   если EC есть, зонд возвращает > 0; если нет — 0 (не таймаут всего ядра). */
fn ec_probe() -> i64 {
    let ok: i64 = 0;
    let a: i64 = 0;
    while a < 4 {
        if ec_read(a) >= 0 { ok = ok + 1; }
        a = a + 1;
    }
    return ok;
}
