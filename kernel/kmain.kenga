@intrinsic fn kf_get_boot_info() -> i64;
@intrinsic fn kf_str(addr: i64) -> str;

fn uart_init() -> i64 {
    asm_outb(0x3F8 + 1, 0x00);
    asm_outb(0x3F8 + 3, 0x80);
    asm_outb(0x3F8 + 0, 0x03);
    asm_outb(0x3F8 + 1, 0x00);
    asm_outb(0x3F8 + 3, 0x03);
    asm_outb(0x3F8 + 2, 0xC7);
    asm_outb(0x3F8 + 4, 0x0B);
    asm_outb(0x3F8 + 4, 0x1E);
    asm_outb(0x3F8 + 0, 0xAE);
    let v: i64 = asm_inb(0x3F8 + 0);
    asm_outb(0x3F8 + 4, 0x0F);
    if v != 0xAE { return 0; }
    return 1;
}

fn uart_tx_empty() -> i64 {
    let v: i64 = asm_inb(0x3F8 + 5);
    if (v & 0x20) != 0 { return 1; }
    return 0;
}

fn uart_putc(c: i64) -> i64 {
    while uart_tx_empty() == 0 { }
    asm_outb(0x3F8 + 0, c);
    return 0;
}

fn uart_puts(s: str) -> i64 {
    let i: i64 = 0;
    while i < len(s) {
        uart_putc(ord(s[i]));
        i = i + 1;
    }
    return 0;
}

fn kp_msg(tag: str, msg: str) -> i64 {
    uart_puts("[");
    uart_puts(tag);
    uart_puts("] ");
    uart_puts(msg);
    uart_putc(10);
    return 0;
}

fn main() -> i64 {
    let ok: i64 = uart_init();

    uart_puts("uart_init=");
    if ok == 1 {
        uart_puts("ok");
    } else {
        uart_puts("FAIL");
    }
    uart_putc(10);

    let bi: i64 = kf_get_boot_info();
    let brand_addr: i64 = mmio_read64(bi + 8);
    let ver_addr: i64 = mmio_read64(bi + 16);
    uart_puts("bootloader: ");
    uart_puts(kf_str(brand_addr));
    uart_puts(" ");
    uart_puts(kf_str(ver_addr));
    uart_putc(10);

    kp_msg("KengaOS", "v0.1 booting on bare metal (x86_64)");
    kp_msg("KengaOS", "UART 16550 at 0x3F8 ready");
    kp_msg("KengaOS", "kmain.kenga compiled via emit-c --freestanding");
    kp_msg("KengaOS", "Hello from Kenga kernel!");

    while 1 == 1 {
        asm_hlt();
    }
    return 0;
}
