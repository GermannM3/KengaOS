/* --- UART (сохранено для CI-гейта) --- */

fn uart_init() -> i64 {
    asm_outb(0x3F8 + 1, 0x00);
    asm_outb(0x3F8 + 3, 0x80);
    asm_outb(0x3F8 + 0, 0x03);
    asm_outb(0x3F8 + 1, 0x00);
    asm_outb(0x3F8 + 3, 0x03);
    asm_outb(0x3F8 + 2, 0xC7);
    asm_outb(0x3F8 + 4, 0x0B);
    asm_outb(0x3F8 + 4, 0x1E);
    asm_outb(0x3F8 + 0, 0xAE);
    let v: i64 = asm_inb(0x3F8 + 0);
    asm_outb(0x3F8 + 4, 0x0F);
    if v != 0xAE { return 0; }
    return 1;
}

fn uart_tx_empty() -> i64 {
    let v: i64 = asm_inb(0x3F8 + 5);
    if (v & 0x20) != 0 { return 1; }
    return 0;
}

fn uart_putc(c: i64) -> i64 {
    while uart_tx_empty() == 0 { }
    asm_outb(0x3F8 + 0, c);
    return 0;
}

fn uart_puts(s: str) -> i64 {
    let i: i64 = 0;
    while i < len(s) {
        uart_putc(ord(s[i]));
        i = i + 1;
    }
    return 0;
}

fn kp_msg(tag: str, msg: str) -> i64 {
    uart_puts("[");
    uart_puts(tag);
    uart_puts("] ");
    uart_puts(msg);
    uart_putc(10);
    return 0;
}

/* --- Фреймбуфер: цветовой экран загрузки --- */

fn fb_boot_screen(bi: i64, ver: i64) -> i64 {
    let BG: i64 = 0x0a0e14;
    let PANEL: i64 = 0x12161f;
    let BAR: i64 = 0x151b28;
    let LINE: i64 = 0x1b2333;
    let GREEN: i64 = 0x00d4aa;
    let BLUE: i64 = 0x5b9dff;
    let DIM: i64 = 0x8892a4;
    let WHITE: i64 = 0xe6edf3;

    let fb: i64 = kf_get_framebuffer();
    let ok: i64 = fb_init(fb);
    if ok != 1 { return 0; }

    let w: i64 = fb_width();
    let h: i64 = fb_height();

    fb_fill(BG);

    /* Верхняя панель */
    fb_hrect(0, 0, w, 42, BAR);
    fb_hrect(0, 42, w, 2, GREEN);
    fb_text(24, 14, GREEN, BAR, "KengaOS");
    fb_text(24 + 8 * 7 + 16, 15, DIM, BAR, "x86_64  ·  boot");
    if ver != 0 {
        fb_text(24 + 8 * 7 + 16 + 8 * 14, 15, GREEN, BAR, kf_str(ver));
    }
    fb_text(w - 8 * 14 - 24, 15, BLUE, BAR, "Limine 12.6");

    /* Заголовок лога */
    fb_text(24, 66, BLUE, BG, "kernel boot log");

    /* Лог */
    let y: i64 = 86;
    fb_text(24, y, DIM, BG, "bootloader: Limine 12.6.0");
    fb_text(24, y + 12, GREEN, BG, "[KengaOS] v0.1 booting on bare metal (x86_64)");
    fb_text(24, y + 24, GREEN, BG, "[KengaOS] UART 16550 at 0x3F8 ready");
    fb_text(24, y + 36, GREEN, BG, "[KengaOS] kmain.kenga compiled via emit-c --freestanding");
    fb_text(24, y + 48, GREEN, BG, "[KengaOS] Hello from Kenga kernel!");
    fb_text(24, y + 60, DIM, BG, "framebuffer: linear FB active (32bpp)");

    /* Нижняя плашка-статус */
    let sb_y: i64 = h - 44;
    fb_hrect(0, sb_y, w, 2, LINE);
    fb_hrect(0, sb_y + 2, w, 42, PANEL);
    fb_text(24, sb_y + 15, WHITE, PANEL, "system: idle");
    fb_text(24 + 8 * 13 + 16, sb_y + 15, GREEN, PANEL, "kernel: alive");
    fb_text(w - 8 * 22 - 24, sb_y + 15, DIM, PANEL, "running on 64-bit long mode");

    return 1;
}

/* --- KengaFS: персистентная ФС, целиком на Kenga (kernel/fs.kenga) ---
   Монтирует/форматирует диск, инкрементирует /boots — это и есть проверка,
   что данные переживают перезагрузку (см. scripts/test-fs-persistence.sh). */
fn fs_boot_gate() -> i64 {
    let fs: FsState = fs_mount();
    if fs.ok != 1 {
        kp_msg("KengaOS", "FS NONE");
        return 0;
    }
    /* C-мост получает состояние ФС до запуска ring-3 приложения */
    user_set_fs(fs.ino, fs.bmp, fs.io, fs.dat, fs.rw, fs.ok);
    let n: i64 = fs_boot_count(fs);
    /* заодно проверяем mkdir -p и запись текста: /system/bootlog.txt */
    fs_write(fs, "/system/bootlog.txt", "KengaOS boot #" + n);
    if fs_selftest(fs) == 1 { kp_msg("KengaOS", "FS TEST OK"); }
    else { kp_msg("KengaOS", "FS TEST FAIL"); }
    user_app_from_disk(fs);
    uart_puts("fs:boot=");
    kf_puti(n);
    uart_puts(" inodes=");
    kf_puti(fs_used(fs));
    uart_puts(" blocks=");
    kf_puti(fs_blocks_used(fs));
    uart_putc(10);
    kp_msg("KengaOS", "FS OK");
    return 1;
}

/* --- Syscall-мост KengaFS (int 0x80, num 16 = cat) ------------------------
   Файловая система живёт на Kenga, поэтому C-обработчик прерывания не читает
   её сам: он зовёт эту функцию, передавая состояние ФС аргументами (в Kenga
   нет глобальных переменных), а байты гоняет через кадр обмена.
   a = путь (адрес в ядре), b = кадр приёмника, c = максимум байт. */
fn fs_syscall(ino: i64, bmp: i64, io: i64, dat: i64, rw: i64, ok: i64, num: i64, a: i64, b: i64, c: i64) -> i64 {
    let fs: FsState = FsState{ ino: ino, bmp: bmp, io: io, dat: dat, rw: rw, ok: ok };
    if num == 16 {                       /* cat: файл -> буфер приложения */
        return fs_read(fs, kf_str(a), b, c);
    }
    if num == 17 {                       /* save: буфер приложения -> файл */
        return fs_write_blob(fs, kf_str(a), b, c);
    }
    if num == 18 { return fs_mkdir(fs, kf_str(a)); }   /* приложение: создать каталог */
    if num == 19 { return fs_rm(fs, kf_str(a)); }      /* приложение: удалить объект */
    return -1;
}

/* --- Магазин .kpkg v2 -----------------------------------------------------
   Формат пакета: "KPKG2\n", строки манифеста, ПУСТАЯ строка, затем бинарный
   payload (ring-3 ELF). Установка = прочитать пакет из initrd, найти payload
   и записать его в KengaFS. Вся логика — на Kenga, ядро C не участвует. */
fn pkg_sig_ok(buf: i64) -> i64 {
    let sig: str = "KPKG2";
    let i: i64 = 0;
    while i < 5 {
        if mmio_read8(buf + i) != ord(sig[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

/* конец манифеста = первая пустая строка ("\n\n"), payload начинается за ней */
fn pkg_payload_off(buf: i64, size: i64) -> i64 {
    let i: i64 = 0;
    while i + 1 < size {
        if mmio_read8(buf + i) == 10 && mmio_read8(buf + i + 1) == 10 { return i + 2; }
        i = i + 1;
    }
    return -1;
}

/* pkg — имя .kpkg в репозитории (initrd), dest — путь в KengaFS.
   Возвращает размер установленного бинаря или < 0. */
fn store_install(fs: FsState, pkg: str, dest: str) -> i64 {
    let buf: i64 = xbuf();
    let cap: i64 = xbuf_size();
    let size: i64 = vfs_cat64(pkg, buf, cap);
    if size <= 0 { return -1; }
    if size >= cap - 1 { return -5; }          /* пакет обрезан буфером */
    if pkg_sig_ok(buf) != 1 { return -2; }
    let off: i64 = pkg_payload_off(buf, size);
    if off < 0 { return -3; }
    let blob: i64 = size - off;
    if blob <= 0 { return -4; }
    if blob >= cap { return -6; }
    return fs_write_blob(fs, dest, buf + off, blob);
}

/* --- Ring 3 приложение с диска -------------------------------------------
   Полный путь приложения: initrd (user-hello.elf) -> KengaFS (/apps/hello.elf)
   -> чтение обратно с диска -> elf_load -> пользовательский режим.
   Это и есть «приложение лежит на диске и запускается», а не вшито в ядро. */
fn user_app_from_disk(fs: FsState) -> i64 {
    /* Файл, который приложение записало в ПРОШЛУЮ загрузку: это доказательство
       настоящей персистентности на уровне приложения (boot 2 видит файл boot 1).
       Читаем до запуска — приложение его перезапишет. */
    let prev: i64 = fs_read(fs, "/apps/state.txt", fs.dat, 256);
    if prev > 0 {
        uart_puts("kenga-app prev: ");
        uart_puts(kf_str(fs.dat));
        uart_putc(10);
    }
    /* ставим приложение ИЗ ПАКЕТА магазина (initrd -> /apps на диске) */
    let n: i64 = store_install(fs, "kenga-app.kpkg", "/apps/kenga-app.elf");
    if n <= 0 { kp_msg("KengaOS", "USERAPP NOELF"); return 0; }
    uart_puts("store: installed kenga-app.kpkg -> /apps/kenga-app.elf ");
    kf_puti(n);
    uart_puts(" bytes\n");
    kp_msg("KengaOS", "STORE INSTALL OK");
    /* второе приложение в /apps — его запускает приложение через sys_spawn */
    let hn: i64 = vfs_cat64("user-hello.elf", xbuf(), xbuf_size());
    if hn > 0 { fs_write_blob(fs, "/apps/hello.elf", xbuf(), hn); }
    let sz: i64 = fs_read(fs, "/apps/kenga-app.elf", xbuf(), xbuf_size());
    if sz <= 0 { kp_msg("KengaOS", "USERAPP READFAIL"); return 0; }
    uart_puts("userapp: elf="); kf_puti(sz); uart_puts(" bytes\n");
    /* Два ring-3 процесса одного и того же приложения: первый — ELF с диска
       (установлен из .kpkg), второй — из initrd. Кооперативное переключение
       по sys_yield, у каждого своя PML4 и свой kernel-стек. */
    let p1: i64 = user_spawn_blob(xbuf(), sz);
    if p1 <= 0 { kp_msg("KengaOS", "USERAPP BADELF"); return 0; }
    let p2: i64 = user_spawn_vfs("user-kenga.elf");
    uart_puts("userapp: pids ");
    kf_puti(p1); uart_puts(" "); kf_puti(p2); uart_putc(10);
    let sr: i64 = user_sched_run();
    if sr == 1 { kp_msg("KengaOS", "SCHED OK"); }
    kp_msg("KengaOS", "USERAPP OK");
    /* приложение записало свой файл — читаем его обратно с диска */
    let r: i64 = fs_read(fs, "/apps/state.txt", fs.dat, 256);
    if r > 0 {
        uart_puts("kenga-app wrote: ");
        uart_puts(kf_str(fs.dat));
        uart_putc(10);
    } else {
        uart_puts("kenga-app wrote: (nothing)\n");
    }
    /* файл, который приложение создало в СВОЁМ каталоге */
    let rd: i64 = fs_read(fs, "/apps/demo/hello.txt", fs.dat, 256);
    if rd > 0 {
        uart_puts("kenga-app dir: ");
        uart_puts(kf_str(fs.dat));
        uart_putc(10);
    } else {
        uart_puts("kenga-app dir: (nothing)\n");
    }
    /* что приложение прочитало через sys_cat — проверяем по файлу */
    let rcat: i64 = fs_read(fs, "/apps/cat.txt", fs.dat, 64);
    if rcat > 0 {
        uart_puts("kenga-app cat file: ");
        uart_puts(kf_str(fs.dat));
        uart_putc(10);
    } else {
        uart_puts("kenga-app cat file: (nothing)\n");
    }
    /* результат работы дескрипторов: приложение положило его в файл */
    let rfd: i64 = fs_read(fs, "/apps/fd.txt", fs.dat, 64);
    if rfd > 0 {
        uart_puts("kenga-app fd file: ");
        uart_puts(kf_str(fs.dat));
        uart_putc(10);
    } else {
        uart_puts("kenga-app fd file: (nothing)\n");
    }
    /* ACPI EC: батарея/температуры. Логика драйвера — на Kenga. */
    uart_puts("PCI dev0=");
    kf_puti(pci_dev0());
    uart_puts(" nic=");
    kf_puti(pci_count_class(2));
    uart_puts(" nicid=");
    kf_puti(pci_nic_id());
    uart_puts(" bar0=");
    kf_puti(pci_bar0(pci_find_class(2)));
    uart_puts(" mac=");
    kf_puti(e1000_mac_lo(pci_bar0(pci_find_class(2))));
    uart_puts(":");
    kf_puti(e1000_mac_hi(pci_bar0(pci_find_class(2))));
    uart_puts(" rst=");
    kf_puti(e1000_reset(pci_bar0(pci_find_class(2))));
    uart_puts(" st=");
    kf_puti(e1000_status(pci_bar0(pci_find_class(2))));
    uart_puts(" ctrl=");
    kf_puti(e1000_link_up(pci_bar0(pci_find_class(2))));
    /* Кольцо приёма: адрес физический, устройство работает по DMA. Проверяем
       обратным чтением, что запись дошла, и печатаем вердикт rxok. */
    /* Включаем bus-master: без него NIC не может DMA-ить дескрипторы. */
    uart_puts(" pci_cmd=");
    kf_puti(pci_enable_bus_master(pci_find_class(2)));
    let nbar: i64 = pci_bar0(pci_find_class(2));
    let rva: i64 = e1000_rx_init(nbar);
    uart_puts(" rxpa=");
    kf_puti(mem_virt_to_phys(rva));
    uart_puts(" rdbal=");
    kf_puti(e1000_rdbal(nbar));
    uart_puts(" rdlen=");
    kf_puti(e1000_rdlen(nbar));
    if e1000_rdbal(nbar) == mem_virt_to_phys(rva) { uart_puts(" rxok=1"); } else { uart_puts(" rxok=0"); }
    let rctl: i64 = e1000_rx_enable(nbar, rva);
    uart_puts(" rctl=");
    kf_puti(rctl);
    uart_puts(" rdh=");
    kf_puti(e1000_rdh(nbar));
    let tva: i64 = e1000_tx_init(nbar);
    uart_puts(" tdbal=");
    kf_puti(e1000_tdbal(nbar));
    uart_puts(" tdlen=");
    kf_puti(e1000_tdlen(nbar));
    if e1000_tdbal(nbar) == mem_virt_to_phys(tva) { uart_puts(" txok=1"); } else { uart_puts(" txok=0"); }
    uart_puts(" tctl=");
    kf_puti(e1000_tctl(nbar));
    /* отправляем ARP-запрос: tdh должен дойти до 1, а rdh показать, пришёл ли ответ */
    let arp: i64 = e1000_arp(nbar, tva, rva);
    uart_puts(" arp_tdh_rdh=");
    kf_puti(arp);
    /* дамп дескриптора передачи, каким его видит устройство: адрес буфера */
    uart_puts(" txd0=");
    kf_puti(e1000_peek(tva));
    uart_puts(" txd1=");
    kf_puti(e1000_peek(tva + 4));
    /* Статус дескриптора передачи: байт 0. Бит DD (0x1) устройство выставляет,
       когда кадр отправлен. Это собственный отчёт устройства о завершении —
       независимый от внешнего дампа трафика. */
    uart_puts(" txds=");
    kf_puti(e1000_peek(tva + 12) - (e1000_peek(tva + 12) / 256) * 256);
    /* Поля length(+8) | cso(+10) | cmd(+11): ожидается 60 и 11 -> 0x0B00003C. */
    uart_puts(" txd2=");
    kf_puti(e1000_peek(tva + 8));
    uart_putc(10);
    uart_puts("EC status=");
    kf_puti(ec_status());
    uart_puts(" probe ok=");
    kf_puti(ec_probe());
    uart_putc(10);
    /* а этот файл приложение удалило само (syscall 19) — должен исчезнуть */
    let rdel: i64 = fs_read(fs, "/apps/demo/bye.txt", fs.dat, 256);
    if (rdel > 0) {
        uart_puts("kenga-app rm: still there: ");
        uart_puts(kf_str(fs.dat));
        uart_putc(10);
    } else {
        uart_puts("kenga-app rm: (nothing)\n");
    }
    return 1;
}

/* Самотест KengaFS: mkdir -p, запись, чтение+сверка, удаление. */
fn fs_selftest(fs: FsState) -> i64 {
    let want: str = "kenga-fs-selftest";
    if fs_write(fs, "/tmp/t.txt", want) < 0 { return 0; }
    let got: i64 = fs_read(fs, "/tmp/t.txt", fs.dat, 4096);
    if got != len(want) { return 0; }
    let s: str = kf_str(fs.dat);
    let i: i64 = 0;
    while i < len(want) {
        if ord(s[i]) != ord(want[i]) { return 0; }
        i = i + 1;
    }
    if fs_rm(fs, "/tmp/t.txt") != 1 { return 0; }
    if fs_lookup(fs, "/tmp/t.txt") >= 0 { return 0; }
    return 1;
}

/* --- PS/2 mouse (polling; IRQ/IDT появится на шаге про прерывания) --- */

fn main() -> i64 {
    let ok: i64 = uart_init();

    uart_puts("uart_init=");
    if ok == 1 {
        uart_puts("ok");
    } else {
        uart_puts("FAIL");
    }
    uart_putc(10);

    let bi: i64 = kf_get_boot_info();
    let brand_addr: i64 = mmio_read64(bi + 8);
    let ver_addr: i64 = mmio_read64(bi + 16);
    uart_puts("bootloader: ");
    uart_puts(kf_str(brand_addr));
    uart_puts(" ");
    uart_puts(kf_str(ver_addr));
    uart_putc(10);

    kp_msg("KengaOS", "v0.1 booting on bare metal (x86_64)");
    kp_msg("KengaOS", "UART 16550 at 0x3F8 ready");
    kp_msg("KengaOS", "kmain.kenga compiled via emit-c --freestanding");
    kp_msg("KengaOS", "Hello from Kenga kernel!");

    let fbp: i64 = kf_get_framebuffer();
    let fbok: i64 = fb_init(fbp);
    if fbok == 1 {
        uart_puts("FB addr=");
        kf_puti(mmio_read64(fbp + 0));
        uart_puts(" w=");
        kf_puti(fb_width());
        uart_puts(" h=");
        kf_puti(fb_height());
        uart_puts(" pitch=");
        kf_puti(mmio_read64(fbp + 24));
        uart_puts(" bpp=");
        kf_puti(mmio_read16(fbp + 32));
        uart_putc(10);
        kp_msg("KengaOS", "FB READY");
    } else {
        kp_msg("KengaOS", "FB NONE");
    }

    let ver: i64 = 0;
    let mr: i64 = kf_get_modules();
    if mr != 0 {
        let mc: i64 = mmio_read64(mr + 8);
        if mc > 0 {
            let mods: i64 = mmio_read64(mr + 16);
            let mod: i64 = mmio_read64(mods);
            let maddr: i64 = mmio_read64(mod + 8);
            let msize: i64 = mmio_read64(mod + 16);
            let vn: i64 = vfs_init_rd(maddr, msize);
            uart_puts("initrd files=");
            kf_puti(vn);
            uart_putc(10);
            ver = vfs_version_addr();
        } else {
            kp_msg("KengaOS", "INITRD NONE");
        }
    }

    fb_boot_screen(bi, ver);

    let mok: i64 = mem_init();
    uart_puts("mem_init=");
    if mok == 1 { uart_puts("ok"); } else { uart_puts("FAIL"); }
    uart_puts(" free_kb=");
    kf_puti(mem_free_bytes() / 1024);
    uart_puts(" frames_kb=");
    kf_puti(mem_pages_free() * 4);
    uart_putc(10);
    kp_msg("KengaOS", "MEM READY");
    /* ACPI: таблицы нужны для мягкого выключения/перезагрузки (kf_acpi.c) */
    acpi_init();
    /* PIO-IDE диск (единое ядро: порт из legacy C-ядра) */
    let dok: i64 = disk_init();
    uart_puts("disk_init=");
    if dok == 1 { uart_puts("ok sec="); kf_puti(disk_sectors()); }
    else { uart_puts("FAIL"); }
    uart_puts(" kind=");   /* 1 = ATA PIO, 2 = AHCI, 3 = virtio-blk */
    kf_puti(disk_kind());
    uart_putc(10);


    let pf: i64 = mem_palloc();
    if pf != 0 {
        mmio_write8(pf, 0xAB);
        let pv: i64 = mmio_read8(pf);
        mem_pfree(pf);
        if pv == 0xAB { kp_msg("KengaOS", "PALLOC OK"); } else { kp_msg("KengaOS", "PALLOC FAIL"); }
    } else {
        kp_msg("KengaOS", "PALLOC NONE");
    }

    let w: i64 = fb_width();
    let h: i64 = fb_height();

    let iok: i64 = intr_init();
    uart_puts("intr_init=");
    if iok == 1 { uart_puts("ok"); } else { uart_puts("FAIL"); }
    uart_putc(10);
    kp_msg("KengaOS", "INTR READY");
    intr_test();
    let ur: i64 = user_boot_test();
    if ur == 1 {
        kp_msg("KengaOS", "RING3 OK");
    } else {
        kp_msg("KengaOS", "RING3 SKIP");
    }

    kp_msg("KengaOS", "SHELL READY");
    kp_msg("KengaOS", "PROC READY");

    let fd: i64 = fdt_boot_test();
    if fd == 1 {
        kp_msg("KengaOS", "FDT PARSED");
    } else {
        kp_msg("KengaOS", "FDT NONE");
    }
    timer_init();
    /* RW-тест (после INTR: изолирован от boot-гейтов).
       Пишем ТОЛЬКО в диск с маркером KENGARWTEST1 (smoke). */
    uart_puts("rw:go");
    uart_putc(10);
    let drw: i64 = disk_rw_test();
    uart_puts("rw=");
    kf_puti(drw);
    uart_putc(10);
    if drw == 1 { kp_msg("KengaOS", "DISK RW OK"); }
    else {
        if drw >= 0 { kp_msg("KengaOS", "DISK RW SKIP"); }
        else { kp_msg("KengaOS", "DISK RW FAIL"); }
    }
    /* пайпы шелла: echo | upper | count */
    let pp: i64 = shell_pipe_selftest();
    if pp == 1 { kp_msg("KengaOS", "PIPE OK"); } else { kp_msg("KengaOS", "PIPE FAIL"); }
    /* KengaFS: персистентная ФС на диске (логика — kernel/fs.kenga) */
    fs_boot_gate();

    let go: i64 = gui_init();   /* hardware bridge: kbd/con/proc/mouse, sti */
    if go == 1 {
        desktop_main();         /* Kenga desktop: init screen + event loop */
    }

    return 0;
}
