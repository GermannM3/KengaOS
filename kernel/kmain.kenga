/* --- UART (сохранено для CI-гейта) --- */

fn uart_init() -> i64 {
    asm_outb(0x3F8 + 1, 0x00);
    asm_outb(0x3F8 + 3, 0x80);
    asm_outb(0x3F8 + 0, 0x03);
    asm_outb(0x3F8 + 1, 0x00);
    asm_outb(0x3F8 + 3, 0x03);
    asm_outb(0x3F8 + 2, 0xC7);
    asm_outb(0x3F8 + 4, 0x0B);
    asm_outb(0x3F8 + 4, 0x1E);
    asm_outb(0x3F8 + 0, 0xAE);
    let v: i64 = asm_inb(0x3F8 + 0);
    asm_outb(0x3F8 + 4, 0x0F);
    if v != 0xAE { return 0; }
    return 1;
}

fn uart_tx_empty() -> i64 {
    let v: i64 = asm_inb(0x3F8 + 5);
    if (v & 0x20) != 0 { return 1; }
    return 0;
}

fn uart_putc(c: i64) -> i64 {
    while uart_tx_empty() == 0 { }
    asm_outb(0x3F8 + 0, c);
    return 0;
}

fn uart_puts(s: str) -> i64 {
    let i: i64 = 0;
    while i < len(s) {
        uart_putc(ord(s[i]));
        i = i + 1;
    }
    return 0;
}

fn kp_msg(tag: str, msg: str) -> i64 {
    uart_puts("[");
    uart_puts(tag);
    uart_puts("] ");
    uart_puts(msg);
    uart_putc(10);
    return 0;
}

/* --- Фреймбуфер: цветовой экран загрузки --- */

fn fb_boot_screen(bi: i64, ver: i64) -> i64 {
    let BG: i64 = 0x0a0e14;
    let PANEL: i64 = 0x12161f;
    let BAR: i64 = 0x151b28;
    let LINE: i64 = 0x1b2333;
    let GREEN: i64 = 0x00d4aa;
    let BLUE: i64 = 0x5b9dff;
    let DIM: i64 = 0x8892a4;
    let WHITE: i64 = 0xe6edf3;

    let fb: i64 = kf_get_framebuffer();
    let ok: i64 = fb_init(fb);
    if ok != 1 { return 0; }

    let w: i64 = fb_width();
    let h: i64 = fb_height();

    fb_fill(BG);

    /* Верхняя панель */
    fb_hrect(0, 0, w, 42, BAR);
    fb_hrect(0, 42, w, 2, GREEN);
    fb_text(24, 14, GREEN, BAR, "KengaOS");
    fb_text(24 + 8 * 7 + 16, 15, DIM, BAR, "x86_64  ·  boot");
    if ver != 0 {
        fb_text(24 + 8 * 7 + 16 + 8 * 14, 15, GREEN, BAR, kf_str(ver));
    }
    fb_text(w - 8 * 14 - 24, 15, BLUE, BAR, "Limine 12.6");

    /* Заголовок лога */
    fb_text(24, 66, BLUE, BG, "kernel boot log");

    /* Лог */
    let y: i64 = 86;
    fb_text(24, y, DIM, BG, "bootloader: Limine 12.6.0");
    fb_text(24, y + 12, GREEN, BG, "[KengaOS] v0.1 booting on bare metal (x86_64)");
    fb_text(24, y + 24, GREEN, BG, "[KengaOS] UART 16550 at 0x3F8 ready");
    fb_text(24, y + 36, GREEN, BG, "[KengaOS] kmain.kenga compiled via emit-c --freestanding");
    fb_text(24, y + 48, GREEN, BG, "[KengaOS] Hello from Kenga kernel!");
    fb_text(24, y + 60, DIM, BG, "framebuffer: linear FB active (32bpp)");

    /* Нижняя плашка-статус */
    let sb_y: i64 = h - 44;
    fb_hrect(0, sb_y, w, 2, LINE);
    fb_hrect(0, sb_y + 2, w, 42, PANEL);
    fb_text(24, sb_y + 15, WHITE, PANEL, "system: idle");
    fb_text(24 + 8 * 13 + 16, sb_y + 15, GREEN, PANEL, "kernel: alive");
    fb_text(w - 8 * 22 - 24, sb_y + 15, DIM, PANEL, "running on 64-bit long mode");

    return 1;
}

/* --- PS/2 mouse (polling; IRQ/IDT появится на шаге про прерывания) --- */

fn main() -> i64 {
    let ok: i64 = uart_init();

    uart_puts("uart_init=");
    if ok == 1 {
        uart_puts("ok");
    } else {
        uart_puts("FAIL");
    }
    uart_putc(10);

    let bi: i64 = kf_get_boot_info();
    let brand_addr: i64 = mmio_read64(bi + 8);
    let ver_addr: i64 = mmio_read64(bi + 16);
    uart_puts("bootloader: ");
    uart_puts(kf_str(brand_addr));
    uart_puts(" ");
    uart_puts(kf_str(ver_addr));
    uart_putc(10);

    kp_msg("KengaOS", "v0.1 booting on bare metal (x86_64)");
    kp_msg("KengaOS", "UART 16550 at 0x3F8 ready");
    kp_msg("KengaOS", "kmain.kenga compiled via emit-c --freestanding");
    kp_msg("KengaOS", "Hello from Kenga kernel!");

    let fbp: i64 = kf_get_framebuffer();
    let fbok: i64 = fb_init(fbp);
    if fbok == 1 {
        uart_puts("FB addr=");
        kf_puti(mmio_read64(fbp + 0));
        uart_puts(" w=");
        kf_puti(fb_width());
        uart_puts(" h=");
        kf_puti(fb_height());
        uart_puts(" pitch=");
        kf_puti(mmio_read64(fbp + 24));
        uart_puts(" bpp=");
        kf_puti(mmio_read16(fbp + 32));
        uart_putc(10);
        kp_msg("KengaOS", "FB READY");
    } else {
        kp_msg("KengaOS", "FB NONE");
    }

    let ver: i64 = 0;
    let mr: i64 = kf_get_modules();
    if mr != 0 {
        let mc: i64 = mmio_read64(mr + 8);
        if mc > 0 {
            let mods: i64 = mmio_read64(mr + 16);
            let mod: i64 = mmio_read64(mods);
            let maddr: i64 = mmio_read64(mod + 8);
            let msize: i64 = mmio_read64(mod + 16);
            let vn: i64 = vfs_init_rd(maddr, msize);
            uart_puts("initrd files=");
            kf_puti(vn);
            uart_putc(10);
            ver = vfs_version_addr();
        } else {
            kp_msg("KengaOS", "INITRD NONE");
        }
    }

    fb_boot_screen(bi, ver);

    let mok: i64 = mem_init();
    uart_puts("mem_init=");
    if mok == 1 { uart_puts("ok"); } else { uart_puts("FAIL"); }
    uart_puts(" free_kb=");
    kf_puti(mem_free_bytes() / 1024);
    uart_puts(" frames_kb=");
    kf_puti(mem_pages_free() * 4);
    uart_putc(10);
    kp_msg("KengaOS", "MEM READY");

    let pf: i64 = mem_palloc();
    if pf != 0 {
        mmio_write8(pf, 0xAB);
        let pv: i64 = mmio_read8(pf);
        mem_pfree(pf);
        if pv == 0xAB { kp_msg("KengaOS", "PALLOC OK"); } else { kp_msg("KengaOS", "PALLOC FAIL"); }
    } else {
        kp_msg("KengaOS", "PALLOC NONE");
    }

    let w: i64 = fb_width();
    let h: i64 = fb_height();

    let iok: i64 = intr_init();
    uart_puts("intr_init=");
    if iok == 1 { uart_puts("ok"); } else { uart_puts("FAIL"); }
    uart_putc(10);
    kp_msg("KengaOS", "INTR READY");
    intr_test();

    kp_msg("KengaOS", "SHELL READY");
    kp_msg("KengaOS", "PROC READY");

    timer_init();

    let go: i64 = gui_init();   /* hardware bridge: kbd/con/proc/mouse, sti */
    if go == 1 {
        desktop_main();         /* Kenga desktop: init screen + event loop */
    }

    return 0;
}
