@intrinsic fn kf_get_boot_info() -> i64;
@intrinsic fn kf_get_framebuffer() -> i64;
@intrinsic fn kf_str(addr: i64) -> str;
@intrinsic fn kf_puti(n: i64) -> i64;

/* Framebuffer FFI (kf_fb.c) */
@intrinsic fn fb_init(fb: i64) -> i64;
@intrinsic fn fb_ready() -> i64;
@intrinsic fn fb_width() -> i64;
@intrinsic fn fb_height() -> i64;
@intrinsic fn fb_fill(color: i64) -> i64;
@intrinsic fn fb_rect(x: i64, y: i64, w: i64, h: i64, color: i64) -> i64;
@intrinsic fn fb_hrect(x: i64, y: i64, w: i64, h: i64, color: i64) -> i64;
@intrinsic fn fb_text(x: i64, y: i64, fg: i64, bg: i64, s: str) -> i64;
@intrinsic fn fb_xor(x: i64, y: i64, color: i64) -> i64;
@intrinsic fn fb_cursor(x: i64, y: i64) -> i64;

/* --- UART (сохранено для CI-гейта) --- */

fn uart_init() -> i64 {
    asm_outb(0x3F8 + 1, 0x00);
    asm_outb(0x3F8 + 3, 0x80);
    asm_outb(0x3F8 + 0, 0x03);
    asm_outb(0x3F8 + 1, 0x00);
    asm_outb(0x3F8 + 3, 0x03);
    asm_outb(0x3F8 + 2, 0xC7);
    asm_outb(0x3F8 + 4, 0x0B);
    asm_outb(0x3F8 + 4, 0x1E);
    asm_outb(0x3F8 + 0, 0xAE);
    let v: i64 = asm_inb(0x3F8 + 0);
    asm_outb(0x3F8 + 4, 0x0F);
    if v != 0xAE { return 0; }
    return 1;
}

fn uart_tx_empty() -> i64 {
    let v: i64 = asm_inb(0x3F8 + 5);
    if (v & 0x20) != 0 { return 1; }
    return 0;
}

fn uart_putc(c: i64) -> i64 {
    while uart_tx_empty() == 0 { }
    asm_outb(0x3F8 + 0, c);
    return 0;
}

fn uart_puts(s: str) -> i64 {
    let i: i64 = 0;
    while i < len(s) {
        uart_putc(ord(s[i]));
        i = i + 1;
    }
    return 0;
}

fn kp_msg(tag: str, msg: str) -> i64 {
    uart_puts("[");
    uart_puts(tag);
    uart_puts("] ");
    uart_puts(msg);
    uart_putc(10);
    return 0;
}

/* --- Фреймбуфер: цветовой экран загрузки --- */

fn fb_boot_screen(bi: i64) -> i64 {
    let BG: i64 = 0x0a0e14;
    let PANEL: i64 = 0x12161f;
    let BAR: i64 = 0x151b28;
    let LINE: i64 = 0x1b2333;
    let GREEN: i64 = 0x00d4aa;
    let BLUE: i64 = 0x5b9dff;
    let DIM: i64 = 0x8892a4;
    let WHITE: i64 = 0xe6edf3;

    let fb: i64 = kf_get_framebuffer();
    let ok: i64 = fb_init(fb);
    if ok != 1 { return 0; }

    let w: i64 = fb_width();
    let h: i64 = fb_height();

    fb_fill(BG);

    /* Верхняя панель */
    fb_hrect(0, 0, w, 42, BAR);
    fb_hrect(0, 42, w, 2, GREEN);
    fb_text(24, 14, GREEN, BAR, "KengaOS");
    fb_text(24 + 8 * 7 + 16, 15, DIM, BAR, "x86_64  ·  v0.1  ·  boot");
    fb_text(w - 8 * 14 - 24, 15, BLUE, BAR, "Limine 12.6");

    /* Заголовок лога */
    fb_text(24, 66, BLUE, BG, "kernel boot log");

    /* Лог */
    let y: i64 = 86;
    fb_text(24, y, DIM, BG, "bootloader: Limine 12.6.0");
    fb_text(24, y + 12, GREEN, BG, "[KengaOS] v0.1 booting on bare metal (x86_64)");
    fb_text(24, y + 24, GREEN, BG, "[KengaOS] UART 16550 at 0x3F8 ready");
    fb_text(24, y + 36, GREEN, BG, "[KengaOS] kmain.kenga compiled via emit-c --freestanding");
    fb_text(24, y + 48, GREEN, BG, "[KengaOS] Hello from Kenga kernel!");
    fb_text(24, y + 60, DIM, BG, "framebuffer: linear FB active (32bpp)");

    /* Нижняя плашка-статус */
    let sb_y: i64 = h - 44;
    fb_hrect(0, sb_y, w, 2, LINE);
    fb_hrect(0, sb_y + 2, w, 42, PANEL);
    fb_text(24, sb_y + 15, WHITE, PANEL, "system: idle");
    fb_text(24 + 8 * 13 + 16, sb_y + 15, GREEN, PANEL, "kernel: alive");
    fb_text(w - 8 * 22 - 24, sb_y + 15, DIM, PANEL, "running on 64-bit long mode");

    return 1;
}

/* --- PS/2 mouse (polling; IRQ/IDT появится на шаге про прерывания) --- */

fn ps2_wait_in() -> i64 {
    let i: i64 = 0;
    while i < 200000 {
        let st: i64 = asm_inb(0x64);
        if (st & 0x02) == 0 { return 1; }
        i = i + 1;
    }
    return 0;
}

fn ps2_wait_out() -> i64 {
    let i: i64 = 0;
    while i < 200000 {
        let st: i64 = asm_inb(0x64);
        if (st & 0x01) != 0 { return 1; }
        i = i + 1;
    }
    return 0;
}

fn mouse_send(data: i64) -> i64 {
    ps2_wait_in();
    asm_outb(0x64, 0xD4);
    ps2_wait_in();
    asm_outb(0x60, data);
    ps2_wait_out();
    let ack: i64 = asm_inb(0x60);
    return ack;
}

fn mouse_init() -> i64 {
    ps2_wait_in();
    asm_outb(0x64, 0xA8);
    ps2_wait_in();
    asm_outb(0x64, 0x20);
    ps2_wait_out();
    let cmd: i64 = asm_inb(0x60);
    cmd = cmd | 0x02;
    cmd = cmd & ~0x20;
    ps2_wait_in();
    asm_outb(0x64, 0x60);
    ps2_wait_in();
    asm_outb(0x60, cmd);
    mouse_send(0xF6);
    let ack: i64 = mouse_send(0xF4);
    if ack == 0xFA { return 1; }
    return 0;
}

fn mouse_loop(w: i64, h: i64) -> i64 {
    let mx: i64 = w / 2;
    let my: i64 = h / 2;
    let idx: i64 = 0;
    let b0: i64 = 0;
    let b1: i64 = 0;
    let shown: i64 = 1;

    fb_cursor(mx, my);

    while 1 == 1 {
        if ps2_wait_out() == 1 {
            let b: i64 = asm_inb(0x60);
            if idx == 0 {
                if (b & 0x08) != 0 {
                    b0 = b;
                    idx = 1;
                }
            } else {
                if idx == 1 {
                    b1 = b;
                    idx = 2;
                } else {
                    let dx: i64 = b1;
                    if (b1 & 0x80) != 0 { dx = dx - 256; }
                    let dy: i64 = b;
                    if (b & 0x80) != 0 { dy = dy - 256; }
                    if shown == 1 {
                        fb_cursor(mx, my);
                    }
                    mx = mx + dx;
                    my = my - dy;
                    if mx < 0 { mx = 0; }
                    if my < 0 { my = 0; }
                    if mx >= w { mx = w - 1; }
                    if my >= h { my = h - 1; }
                    fb_cursor(mx, my);
                    shown = 1;
                    idx = 0;
                }
            }
        }
        asm_hlt();
    }
    return 0;
}

fn main() -> i64 {
    let ok: i64 = uart_init();

    uart_puts("uart_init=");
    if ok == 1 {
        uart_puts("ok");
    } else {
        uart_puts("FAIL");
    }
    uart_putc(10);

    let bi: i64 = kf_get_boot_info();
    let brand_addr: i64 = mmio_read64(bi + 8);
    let ver_addr: i64 = mmio_read64(bi + 16);
    uart_puts("bootloader: ");
    uart_puts(kf_str(brand_addr));
    uart_puts(" ");
    uart_puts(kf_str(ver_addr));
    uart_putc(10);

    kp_msg("KengaOS", "v0.1 booting on bare metal (x86_64)");
    kp_msg("KengaOS", "UART 16550 at 0x3F8 ready");
    kp_msg("KengaOS", "kmain.kenga compiled via emit-c --freestanding");
    kp_msg("KengaOS", "Hello from Kenga kernel!");

    let fbp: i64 = kf_get_framebuffer();
    let fbok: i64 = fb_init(fbp);
    if fbok == 1 {
        uart_puts("FB addr=");
        kf_puti(mmio_read64(fbp + 0));
        uart_puts(" w=");
        kf_puti(fb_width());
        uart_puts(" h=");
        kf_puti(fb_height());
        uart_puts(" pitch=");
        kf_puti(mmio_read64(fbp + 24));
        uart_puts(" bpp=");
        kf_puti(mmio_read16(fbp + 32));
        uart_putc(10);
        kp_msg("KengaOS", "FB READY");
    } else {
        kp_msg("KengaOS", "FB NONE");
    }

    fb_boot_screen(bi);

    let w: i64 = fb_width();
    let h: i64 = fb_height();

    let mok: i64 = mouse_init();
    uart_puts("mouse_init=");
    if mok == 1 {
        uart_puts("ok");
    } else {
        uart_puts("FAIL");
    }
    uart_putc(10);

    mouse_loop(w, h);

    return 0;
}
