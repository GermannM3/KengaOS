/* desktop.kenga — KengaOS 0.5: the agent desktop, written in Kenga.
 *
 * Everything that used to live in kf_gui.c (event loop, sidebar, app/agent
 * selection, all views) now lives here. C (kf_gui.c) is reduced to a thin
 * bridge that inits the hardware and calls k_desktop_main().
 */

/* --- state threaded through the desktop (Kenga has no globals) --- */
struct DesktopState { cur_app: i64, sel_pid: i64, model_a: i64, model_b: i64, model_out: i64, drag_win: i64, drag_ox: i64, drag_oy: i64, hist: list }

/* --- cursor (XOR draw; calling fb_cursor twice erases it) --- */
fn cur_draw(mx: i64, my: i64) -> i64 {
    fb_cursor(mx, my);
    return 0;
}
fn cur_erase(mx: i64, my: i64) -> i64 {
    fb_cursor(mx, my);
    return 0;
}

/* --- drawing helpers (Kenga-facing) --- */
fn drect(x: i64, y: i64, w: i64, h: i64, c: i64) -> i64 { return fb_hrect(x, y, w, h, c); }
fn dtext(x: i64, y: i64, fg: i64, bg: i64, s: str) -> i64 { return fb_text_aa(x, y + 3, fg, bg, s); }
fn din(x: i64, y: i64, w: i64, h: i64, mx: i64, my: i64) -> i64 {
    if mx >= x && mx < x + w && my >= y && my < y + h { return 1; }
    return 0;
}

/* --- desktop metrics, computed from the real framebuffer (adaptive layout) ---
   Reference: topbar 38px + floating left dock + free-floating panels.
   sb (sidebar) is 0 now — the dock is floating, not a full-height sidebar. */
fn dmetrics(w: i64, h: i64) -> DesktopMetrics {
    let sb: i64 = 0;
    let tb: i64 = 38;
    if h < 500 { tb = 32; }
    return DesktopMetrics{ sb: sb, tb: tb, stb: 0 };
}

struct DesktopMetrics { sb: i64, tb: i64, stb: i64 }

/* --- redraw the whole desktop --- */
fn draw_desktop(st: DesktopState) -> i64 {
    let W: i64 = fb_width();
    let H: i64 = fb_height();
    let m: DesktopMetrics = dmetrics(W, H);
    draw_wallpaper(W, H);
    ui_chrome(W, H, m.sb, m.tb, m.stb,
              proc_count(), time_uptime_ms() / 1000, mouse_x(), mouse_y(), st.cur_app);
    draw_command_center(W, H, st);
    /* floating input bar (chat) at the bottom */
    draw_input_bar(W, H, m.sb, m.tb, m.stb);
    /* live log floating bottom-right */
    draw_log(W, H, m.sb, m.tb, m.stb);
    /* agent windows (CAP_UI) */
    draw_windows();
    /* dock LAST: it floats above everything and always eats its clicks */
    draw_dock(W, H, st.cur_app);
    return 0;
}

/* Aurora Command Center: the desktop is a control surface for agents, not
   an application window stretched over the whole screen. */
fn draw_command_center(w: i64, h: i64, st: DesktopState) -> i64 {
    let panel: i64 = 0x111a31;
    let panel2: i64 = 0x172441;
    let text: i64 = 0xe6edf3;
    let dim: i64 = 0x8fb3d9;
    let cyan: i64 = 0x22d3ee;
    let violet: i64 = 0x8b7bff;
    let green: i64 = 0x3ddc84;
    let x: i64 = 96;
    let y: i64 = 72;
    let ow: i64 = w - 128;
    let oh: i64 = h - 150;

    fb_blend_rect(x + 6, y + 12, ow, oh, 0x000000, 45);
    fb_blend_rrect_grad(x, y, ow, oh, 24, 0x202b52, 0x0b1020, 178);
    fb_blend_rect(x + 24, y, ow - 48, 1, 0xffffff, 28);
    fb_text_aa(x + 30, y + 20, text, panel, "KENGAOS COMMAND CENTER");
    fb_text_aa(x + ow - 190, y + 20, dim, panel, "CAP_UI  ·  IPC  ·  ONLINE");

    /* agent rail */
    fb_blend_rrect_grad(x + 18, y + 58, 220, oh - 82, 18, 0x182544, 0x0d1528, 190);
    fb_text_aa(x + 36, y + 82, cyan, panel, "AGENT SPACE");
    fb_text_aa(x + 36, y + 116, green, panel, "●  init");
    fb_text_aa(x + 36, y + 146, green, panel, "●  ui-agent");
    fb_text_aa(x + 36, y + 176, green, panel, "●  model-agent");
    fb_text_aa(x + 36, y + 206, dim, panel, "●  shell-agent");
    fb_blend_rrect(x + 34, y + oh - 116, 184, 36, 12, violet, 190);
    fb_text_aa(x + 52, y + oh - 105, 0x0b1020, violet, "+  NEW AGENT");

    /* hero: live process tree */
    let hx: i64 = x + 258;
    let hy: i64 = y + 58;
    let hw: i64 = ow - 520;
    let hh: i64 = oh - 82;
    fb_blend_rrect_grad(hx, hy, hw, hh, 18, 0x1a294a, 0x0e172b, 205);
    fb_text_aa(hx + 24, hy + 24, text, panel, "LIVE AGENT GRAPH");
    fb_text_aa(hx + hw - 122, hy + 24, cyan, panel, "4 RUNNING");
    fb_blend_rect(hx + 20, hy + 54, hw - 40, 1, 0xffffff, 18);
    let n: i64 = proc_count();
    let i: i64 = 0;
    while i < n && i < 8 {
        let ry: i64 = hy + 76 + i * 36;
        if proc_pid_at(i) == st.sel_pid { fb_blend_rrect(hx + 18, ry - 5, hw - 36, 28, 10, violet, 70); }
        fb_disc(hx + 34, ry + 8, 4, green);
        dtext(hx + 52, ry, text, panel, proc_name_at(i));
        dtext(hx + hw - 122, ry, dim, panel, "PID");
        dtext(hx + hw - 88, ry, cyan, panel, proc_pid_at(i));
        i = i + 1;
    }
    fb_text_aa(hx + 24, hy + hh - 34, dim, panel, "select an agent to inspect memory, model and capabilities");

    /* telemetry cards */
    let rx: i64 = x + ow - 244;
    let rw: i64 = 220;
    fb_blend_rrect_grad(rx, y + 58, rw, 112, 18, 0x1a294a, 0x0e172b, 205);
    fb_text_aa(rx + 18, y + 80, dim, panel, "MODEL AGENT");
    fb_text_aa(rx + 18, y + 112, green, panel, "ONLINE");
    fb_text_aa(rx + 18, y + 138, text, panel, "MLP · XOR inference");
    fb_blend_rrect_grad(rx, y + 184, rw, 112, 18, 0x1a294a, 0x0e172b, 205);
    fb_text_aa(rx + 18, y + 206, dim, panel, "SYSTEM HEALTH");
    fb_text_aa(rx + 18, y + 238, cyan, panel, "CPU  07%   RAM  06%");
    fb_text_aa(rx + 18, y + 264, green, panel, "ALL SYSTEMS NOMINAL");
    return 0;
}

/* --- main view as a glass window (titlebar + traffic lights + content) --- */
fn draw_view_window(x: i64, y: i64, w: i64, h: i64, st: DesktopState) -> i64 {
    let C_PANEL2: i64 = 0x1a2030;
    let C_TEXT: i64 = 0xe6edf3;
    let C_RED: i64 = 0xff5f57;
    let C_YEL: i64 = 0xfebc2e;
    let C_GRN: i64 = 0x28c840;
    /* soft shadow */
    fb_blend_rect(x + 3, y + 8, w, h, 0x000000, 46);
    fb_blend_rect(x + 6, y + 14, w, h, 0x000000, 30);
    /* glass body: translucent LIGHT panel over the wallpaper (reference:
       rgba(22,28,48,.78) -> brighter than the bg, so it reads as glass) */
    fb_blend_rrect_grad(x, y, w, h, 22, 0x161c30, 0x0a0e1a, 199);
    /* titlebar: lighter glass, rounded TOP corners only */
    fb_blend_rrect_top(x, y, w, 44, 22, 0xffffff, 10);
    fb_blend_rect(x + 22, y + 43, w - 44, 1, 0xffffff, 20);
    /* hairline border: only along the STRAIGHT edges (never across corners) */
    fb_blend_rect(x + 22, y, w - 44, 1, 0xffffff, 30);
    fb_blend_rect(x + 22, y + h - 1, w - 44, 1, 0xffffff, 30);
    fb_blend_rect(x, y + 22, 1, h - 44, 0xffffff, 30);
    fb_blend_rect(x + w - 1, y + 22, 1, h - 44, 0xffffff, 30);
    /* traffic lights: AA discs (macOS style) */
    fb_disc(x + 18, y + 22, 5, C_RED);
    fb_disc(x + 38, y + 22, 5, C_YEL);
    fb_disc(x + 58, y + 22, 5, C_GRN);
    /* window title by app */
    if st.cur_app == 0 { dtext(x + 80, y + 14, C_TEXT, C_PANEL2, "Agents"); }
    if st.cur_app == 1 { dtext(x + 80, y + 14, C_TEXT, C_PANEL2, "Model"); }
    if st.cur_app == 2 { dtext(x + 80, y + 14, C_TEXT, C_PANEL2, "Files"); }
    if st.cur_app == 3 { dtext(x + 80, y + 14, C_TEXT, C_PANEL2, "System"); }
    if st.cur_app == 4 { dtext(x + 80, y + 14, C_TEXT, C_PANEL2, "Terminal"); }
    /* content */
    draw_app(x + 16, y + 56, w - 32, h - 68, st);
    return 0;
}

/* --- floating left dock (reference: vertical, centered, glass, r18) --- */
fn draw_dock(w: i64, h: i64, cur: i64) -> i64 {
    let HILITE: i64 = 0x8b7bff;
    let NEON: i64 = 0x22d3ee;
    let TEXT: i64 = 0xe6edf3;
    let DIM: i64 = 0x4a5578;
    let n: i64 = ui_window_count();
    let dw: i64 = 64;
    let dh: i64 = 5 * 52 + 20;
    let dx: i64 = 12;
    let dy: i64 = (h - dh) / 2;
    /* glass dock bar: reference .glass gradient + r18 */
    fb_blend_rrect_grad(dx, dy, dw, dh, 18, 0x161c30, 0x0a0e1a, 196);
    fb_blend_rect(dx + 18, dy, dw - 36, 1, 0xffffff, 20);
    /* dock icons: vector SDF, active highlighted */
    let i: i64 = 0;
    while i < 5 {
        let iy: i64 = dy + 10 + i * 52;
        let active: i64 = 0;
        if cur == i { active = 1; }
        /* .dock-btn: 44x44 r12; active = white .1 + 1px border .14 */
        fb_blend_rrect(dx + 10, iy, 44, 44, 12, 0xffffff, 26);
        if active == 1 {
            fb_blend_rrect(dx + 10, iy, 44, 44, 12, 0xffffff, 26);
            fb_blend_rect(dx + 12, iy, 40, 1, 0xffffff, 36);
            fb_blend_rect(dx + 12, iy + 43, 40, 1, 0xffffff, 36);
            fb_blend_rect(dx + 10, iy + 12, 1, 20, 0xffffff, 36);
            fb_blend_rect(dx + 53, iy + 12, 1, 20, 0xffffff, 36);
        }
        /* icons: vector SDF, anti-aliased (agents/model/files/system) */
        let ic_col: i64 = NEON;
        if active == 1 { ic_col = 0x0b0f1a; }
        fb_icon(dx + 22, iy + 12, i, ic_col);
        if active != 1 {
            /* hover-ish hairline on top of the glass square */
            fb_blend_rect(dx + 16, iy + 1, 32, 1, 0xffffff, 22);
        }
        /* running indicator: 4px cyan dot, bottom center (reference .run) */
        if n > 0 {
            fb_glow(dx + 32, iy + 40, 5, NEON, 90);
            fb_disc(dx + 32, iy + 40, 2, NEON);
        }
        i = i + 1;
    }
    return 0;
}

/* 12x12 pixel icons drawn from row bitmaps (MSB left). Each row is two
   chars: bits 0..7, then bits 8..11 (4 bits in the low nibble). */
fn icon_agents(x: i64, y: i64, c: i64) -> i64 {
    fb_hrect(x + 2, y + 2, 3, 3, c);            /* head */
    fb_hrect(x + 2, y + 8, 8, 3, c);            /* shoulders */
    return 0;
}
fn icon_model(x: i64, y: i64, c: i64) -> i64 {
    fb_hrect(x + 5, y + 1, 3, 3, c);            /* top node */
    fb_hrect(x + 0, y + 8, 3, 3, c);            /* left node */
    fb_hrect(x + 10, y + 8, 3, 3, c);           /* right node */
    fb_hrect(x + 5, y + 4, 3, 3, c);            /* middle node */
    return 0;
}
fn icon_files(x: i64, y: i64, c: i64) -> i64 {
    fb_hrect(x + 1, y + 2, 7, 3, c);            /* folder tab */
    fb_hrect(x + 1, y + 5, 10, 6, c);           /* folder body */
    return 0;
}
fn icon_system(x: i64, y: i64, c: i64) -> i64 {
    fb_hrect(x + 4, y + 2, 4, 9, c);            /* vertical slider */
    fb_hrect(x + 2, y + 4, 8, 2, c);            /* horizontal bar */
    return 0;
}
fn icon_window(x: i64, y: i64, c: i64) -> i64 {
    fb_hrect(x + 1, y + 1, 10, 2, c);           /* title bar */
    fb_hrect(x + 1, y + 4, 10, 7, c);           /* body */
    return 0;
}

/* --- wallpaper: the actual reference image (embedded, 160x100 upscaled) ---
   Plus the reference's two drifting glows and a vignette. */
fn draw_wallpaper(w: i64, h: i64) -> i64 {
    wp_draw(0, 0, w, h);
    /* reference wallGlow: accent top-left, accent2 bottom-right */
    fb_glow(w * 12 / 100, h * 18 / 100, h * 42 / 100, 0x8b7bff, 40);
    fb_glow(w * 88 / 100, h * 84 / 100, h * 46 / 100, 0x22d3ee, 36);
    /* vignette: darken the edges (radial) */
    fb_blend_rect(0, 0, w, 3, 0x000000, 60);
    fb_blend_rect(0, 3, w, 6, 0x000000, 30);
    fb_blend_rect(0, h - 9, w, 6, 0x000000, 30);
    fb_blend_rect(0, h - 3, w, 3, 0x000000, 60);
    return 0;
}

/* --- live agent event log: floating panel bottom-right (320px) --- */
fn draw_log(w: i64, h: i64, sb: i64, tb: i64, stb: i64) -> i64 {
    let C_TEXT: i64 = 0xe6edf3;
    let C_DIM: i64 = 0x8fb3d9;
    let C_GREEN: i64 = 0x22d3ee;
    let lw: i64 = 320;
    let lh: i64 = 118;
    let lx: i64 = w - lw - 12;
    let ly: i64 = h - lh - 12;
    /* glass panel */
    fb_blend_rect(lx + 3, ly + 6, lw, lh, 0x000000, 40);
    fb_blend_rrect_grad(lx, ly, lw, lh, 22, 0x161c30, 0x0a0e1a, 196);
    fb_blend_rect(lx + 22, ly, lw - 44, 1, 0xffffff, 26);
    /* header: blinking dot + title */
    fb_glow(lx + 14, ly + 14, 4, C_GREEN, 160);
    fb_hrect(lx + 11, ly + 11, 7, 7, C_GREEN);
    dtext(lx + 26, ly + 8, C_DIM, 0x1a2030, "zhivoi log · IPC");
    /* last 4 events */
    let i: i64 = 0;
    while i < 4 {
        let s: str = ui_log_at(i);
        if len(s) > 0 {
            dtext(lx + 12, ly + 26 + i * 20, C_TEXT, 0x1a2030, s);
        }
        i = i + 1;
    }
    return 0;
}

/* --- agent chat input bar: floating bottom-center --- */
fn draw_input_bar(w: i64, h: i64, sb: i64, tb: i64, stb: i64) -> i64 {
    let C_ACCENT: i64 = 0x8b7bff;
    let C_TEXT: i64 = 0xe6edf3;
    let C_DIM: i64 = 0x8fb3d9;
    let C_GREEN: i64 = 0x22d3ee;
    let bw: i64 = w - 108 - 360;
    let bx: i64 = 108;
    let by: i64 = h - 52;
    fb_blend_rect(bx + 2, by + 5, bw, 36, 0x000000, 36);
    fb_blend_rrect_grad(bx, by, bw, 36, 18, 0x161c30, 0x0a0e1a, 196);
    fb_blend_rect(bx, by, bw, 1, 0xffffff, 26);
    fb_text_aa(bx + 14, by + 10, C_GREEN, 0x1a2030, "> ");
    let il: i64 = fb_text_aa(bx + 30, by + 10, C_TEXT, 0x1a2030, ui_input_str());
    fb_text_aa(bx + 30 + il, by + 10, C_ACCENT, 0x1a2030, "_");
    /* send button */
    fb_blend_rrect(bx + bw - 100, by + 5, 92, 26, 13, C_ACCENT, 220);
    fb_text_aa(bx + bw - 76, by + 10, 0x0b0f1a, C_ACCENT, "send");
    return 0;
}

/* --- agent-created windows, drawn on top (sorted by z, later = higher) --- */
fn draw_windows() -> i64 {
    let C_PANEL: i64 = 0x141822;
    let C_PANEL2: i64 = 0x1a2030;
    let C_ACCENT: i64 = 0x8b7bff;
    let C_TEXT: i64 = 0xe6edf3;
    let C_DIM: i64 = 0x8fb3d9;
    let C_RED: i64 = 0xff5f57;
    let C_YEL: i64 = 0xfebc2e;
    let C_GRN: i64 = 0x28c840;
    let n: i64 = ui_window_count();
    if n == 0 { return 0; }
    /* find the topmost z (focused window) */
    let maxz: i64 = 0;
    let mi: i64 = 0;
    while mi < n {
        if ui_window_z(mi) > maxz { maxz = ui_window_z(mi); }
        mi = mi + 1;
    }
    /* draw in z order: lowest z first, highest last (on top).
       Iterate z values 1..maxz so each window is drawn exactly once. */
    let z: i64 = 1;
    let drawn: i64 = 0;
    while drawn < n && z <= maxz {
        let i: i64 = 0;
        let found: i64 = -1;
        while i < n {
            if ui_window_z(i) == z { found = i; }
            i = i + 1;
        }
        if found >= 0 {
            let wx: i64 = ui_window_x(found);
            let wy: i64 = ui_window_y(found);
            let ww: i64 = ui_window_w(found);
            let wh: i64 = ui_window_h(found);
            let top: i64 = 0;
            if z == maxz { top = 1; }    /* highest z = focused */
            /* soft shadow (3 blend layers, like the reference) */
            fb_blend_rect(wx + 3, wy + 8, ww, wh, 0x000000, 46);
            fb_blend_rect(wx + 6, wy + 14, ww, wh, 0x000000, 30);
            /* glass body: reference .glass gradient */
            fb_blend_rrect_grad(wx, wy, ww, wh, 22, 0x161c30, 0x0a0e1a, 199);
            /* titlebar: lighter glass, rounded TOP corners only */
            fb_blend_rrect_top(wx, wy, ww, 44, 22, 0xffffff, 10);
            fb_blend_rect(wx + 22, wy + 43, ww - 44, 1, 0xffffff, 20);
            /* hairline border: straight edges only */
            fb_blend_rect(wx + 22, wy, ww - 44, 1, 0xffffff, 30);
            fb_blend_rect(wx + 22, wy + wh - 1, ww - 44, 1, 0xffffff, 30);
            fb_blend_rect(wx, wy + 22, 1, wh - 44, 0xffffff, 30);
            fb_blend_rect(wx + ww - 1, wy + 22, 1, wh - 44, 0xffffff, 30);
            /* focused window: accent glow border */
            if top == 1 {
                fb_blend_rect(wx + 22, wy - 1, ww - 44, 1, C_ACCENT, 96);
                fb_blend_rect(wx + 22, wy + wh, ww - 44, 1, C_ACCENT, 96);
                fb_blend_rect(wx - 1, wy + 22, 1, wh - 44, C_ACCENT, 96);
                fb_blend_rect(wx + ww, wy + 22, 1, wh - 44, C_ACCENT, 96);
            }
            /* traffic lights: AA discs (macOS style) */
            fb_disc(wx + 18, wy + 22, 5, C_RED);
            fb_disc(wx + 38, wy + 22, 5, C_YEL);
            fb_disc(wx + 58, wy + 22, 5, C_GRN);
            dtext(wx + 80, wy + 14, C_TEXT, C_PANEL2, ui_window_title(found));
            dtext(wx + 12, wy + 54, C_TEXT, C_PANEL, ui_window_text(found));
            drawn = drawn + 1;
        }
        z = z + 1;
    }
    return 0;
}

/* find the topmost window containing (mx,my); returns its index or -1 */
fn win_at(mx: i64, my: i64) -> i64 {
    let n: i64 = ui_window_count();
    if n == 0 { return -1; }
    let best: i64 = -1;
    let bestz: i64 = -1;
    let i: i64 = 0;
    while i < n {
        let wx: i64 = ui_window_x(i);
        let wy: i64 = ui_window_y(i);
        let ww: i64 = ui_window_w(i);
        let wh: i64 = ui_window_h(i);
        if mx >= wx && mx < wx + ww && my >= wy && my < wy + wh {
            if ui_window_z(i) > bestz { bestz = ui_window_z(i); best = i; }
        }
        i = i + 1;
    }
    return best;
}

/* --- render the selected app's content --- */
fn draw_app(x: i64, y: i64, w: i64, h: i64, st: DesktopState) -> i64 {
    if st.cur_app == 0 { return draw_agents(x, y, w, h, st); }
    if st.cur_app == 1 { return draw_model(x, y, w, h, st); }
    if st.cur_app == 2 { return draw_files(x, y, w, h, st); }
    if st.cur_app == 3 { return draw_system(x, y, w, h, st); }
    if st.cur_app == 4 { return draw_terminal(x, y, w, h, st); }
    return 0;
}

/* --- Terminal: live agent event stream (the shell's stdout) --- */
fn draw_terminal(x: i64, y: i64, w: i64, h: i64, st: DesktopState) -> i64 {
    let C_BG: i64 = 0x10131c;
    let C_TEXT: i64 = 0xe6edf3;
    let C_DIM: i64 = 0x8fb3d9;
    let C_GREEN: i64 = 0x22d3ee;
    fb_blend_rrect(x, y, w, h, 14, 0x080b14, 89);
    /* prompt line */
    dtext(x + 12, y + 10, C_GREEN, C_BG, "kenga@os");
    dtext(x + 96, y + 10, C_DIM, C_BG, "~");
    dtext(x + 110, y + 10, C_TEXT, C_BG, "live agent stream");
    fb_blend_rect(x, y + 32, w, 1, 0xffffff, 14);
    /* log lines, newest at the bottom of the view */
    let rows: i64 = (h - 52) / 22;
    if rows > 14 { rows = 14; }
    if rows < 1 { rows = 1; }
    let i: i64 = rows;
    while i >= 1 {
        let s: str = ui_log_at(rows - i);
        if len(s) > 0 {
            dtext(x + 12, y + 40 + (i - 1) * 22, C_TEXT, C_BG, s);
        }
        i = i - 1;
    }
    /* live prompt with the input bar content */
    dtext(x + 12, y + 44 + rows * 22, C_GREEN, C_BG, ">");
    dtext(x + 26, y + 44 + rows * 22, C_TEXT, C_BG, ui_input_str());
    return 0;
}

fn draw_agents(x: i64, y: i64, w: i64, h: i64, st: DesktopState) -> i64 {
    let C_BG: i64 = 0x10131c;
    let C_TEXT: i64 = 0xe6edf3;
    let C_ACCENT: i64 = 0x8b7bff;
    let C_DIM: i64 = 0x8fb3d9;
    let C_HILITE: i64 = 0x8b7bff;
    let C_GREEN: i64 = 0x22d3ee;
    let C_PANEL2: i64 = 0x1a2030;
    dtext(x, y, C_TEXT, C_BG, "Agents (process tree)");
    let n: i64 = proc_count();
    let row: i64 = y + 28;
    let i: i64 = 0;
    while i < n && i < 20 {
        let flag: i64 = 0;
        if proc_pid_at(i) == st.sel_pid { flag = 1; }
        let bg: i64 = C_BG;
        if flag == 1 { bg = C_HILITE; }
        fb_hrect(x, row, w, 20, bg);
        dtext(x + 6, row + 4, C_ACCENT, bg, proc_pid_at(i));
        dtext(x + 40, row + 4, C_TEXT, bg, proc_name_at(i));
        dtext(x + 120, row + 4, C_DIM, bg, "p:");
        dtext(x + 134, row + 4, C_DIM, bg, proc_parent_at(i));
        dtext(x + 200, row + 4, C_DIM, bg, "q:");
        dtext(x + 214, row + 4, C_DIM, bg, proc_qlen(proc_pid_at(i)));
        row = row + 20;
        i = i + 1;
    }
    /* details of selected */
    if st.sel_pid > 0 {
        let dy: i64 = y + 28 + 20 * n + 8;
        if n > 20 { dy = y + 28 + 20 * 20 + 8; }
        fb_hrect(x, dy, w, h - (dy - y), C_PANEL2);
        dtext(x + 12, dy + 8, C_GREEN, C_PANEL2, "Selected agent");
        dtext(x + 12, dy + 28, C_TEXT, C_PANEL2, "PID  " + st.sel_pid);
        let j: i64 = 0;
        while j < n {
            if proc_pid_at(j) == st.sel_pid {
                dtext(x + 12, dy + 48, C_TEXT, C_PANEL2, "Name " + proc_name_at(j));
                dtext(x + 12, dy + 68, C_TEXT, C_PANEL2, "Caps " + proc_caps(st.sel_pid));
            }
            j = j + 1;
        }
    }
    return 0;
}

fn draw_model(x: i64, y: i64, w: i64, h: i64, st: DesktopState) -> i64 {
    let C_BG: i64 = 0x10131c;
    let C_TEXT: i64 = 0xe6edf3;
    let C_DIM: i64 = 0x8fb3d9;
    let C_PANEL2: i64 = 0x1a2030;
    let C_HILITE: i64 = 0x8b7bff;
    let C_ACCENT: i64 = 0x8b7bff;
    let C_GREEN: i64 = 0x22d3ee;
    dtext(x, y, C_TEXT, C_BG, "Kenga Model (MLP, XOR)");
    dtext(x, y + 30, C_DIM, C_BG, "in1");
    fb_hrect(x + 40, y + 26, 60, 24, C_PANEL2);
    dtext(x + 48, y + 32, C_TEXT, C_PANEL2, st.model_a);
    dtext(x + 130, y + 30, C_DIM, C_BG, "in2");
    fb_hrect(x + 170, y + 26, 60, 24, C_PANEL2);
    dtext(x + 178, y + 32, C_TEXT, C_PANEL2, st.model_b);
    fb_hrect(x, y + 60, 110, 30, C_ACCENT);
    dtext(x + 16, y + 68, C_BG, C_ACCENT, "Inference");
    fb_hrect(x + 40, y + 100, 40, 24, C_HILITE);
    dtext(x + 52, y + 106, C_TEXT, C_HILITE, "0");
    fb_hrect(x + 90, y + 100, 40, 24, C_HILITE);
    dtext(x + 102, y + 106, C_TEXT, C_HILITE, "1");
    dtext(x + 170, y + 106, C_DIM, C_BG, "in1");
    fb_hrect(x + 40, y + 130, 40, 24, C_HILITE);
    dtext(x + 52, y + 136, C_TEXT, C_HILITE, "0");
    fb_hrect(x + 90, y + 130, 40, 24, C_HILITE);
    dtext(x + 102, y + 136, C_TEXT, C_HILITE, "1");
    dtext(x + 170, y + 136, C_DIM, C_BG, "in2");
    dtext(x, y + 180, C_GREEN, C_BG, "output:");
    dtext(x + 80, y + 180, C_TEXT, C_BG, st.model_out);
    /* inference history (last runs) */
    dtext(x, y + 210, C_DIM, C_BG, "history:");
    let hi: i64 = 0;
    for v in st.hist {
        if hi < 8 {
            dtext(x + 8, y + 222 + hi * 18, C_TEXT, C_BG, v);
        }
        hi = hi + 1;
    }
    return 0;
}

fn draw_files(x: i64, y: i64, w: i64, h: i64, st: DesktopState) -> i64 {
    let C_BG: i64 = 0x10131c;
    let C_TEXT: i64 = 0xe6edf3;
    let C_DIM: i64 = 0x8fb3d9;
    dtext(x, y, C_TEXT, C_BG, "Files (VFS)");
    let n: i64 = vfs_count();
    let i: i64 = 0;
    while i < n && i < 20 {
        dtext(x + 8, y + 24 + i * 20, C_TEXT, C_BG, vfs_name(i));
        dtext(x + 120, y + 24 + i * 20, C_DIM, C_BG, "cat to view");
        i = i + 1;
    }
    return 0;
}

fn draw_system(x: i64, y: i64, w: i64, h: i64, st: DesktopState) -> i64 {
    let C_BG: i64 = 0x10131c;
    let C_TEXT: i64 = 0xe6edf3;
    let C_DIM: i64 = 0x8fb3d9;
    let C_PANEL2: i64 = 0x1a2030;
    let C_GREEN: i64 = 0x22d3ee;
    dtext(x, y, C_TEXT, C_BG, "System");
    dtext(x + 8, y + 24, C_TEXT, C_BG, "CPU  " + hw_cpu_brand_str());
    dtext(x + 8, y + 44, C_TEXT, C_BG, "RAM free " + mem_pages_free());
    dtext(x + 8, y + 64, C_TEXT, C_BG, "Uptime " + time_uptime_ms() / 1000);
    /* live RAM bar, computed in Kenga: total = sum of usable memmap regions
       (type 0), used = total - free. Nothing here touches C logic. */
    let total: i64 = mem_total_kb();
    let used: i64 = 0;
    if total > 0 { used = total - mem_pages_free() * 4; }
    let barw: i64 = 300;
    let barx: i64 = x + 8;
    let bary: i64 = y + 88;
    fb_hrect(barx, bary, barw, 14, C_PANEL2);
    if total > 0 {
        let fill: i64 = used * barw / total;
        if fill > barw { fill = barw; }
        if fill > 0 { fb_hrect(barx, bary, fill, 14, C_GREEN); }
    }
    let pct: i64 = 0;
    if total > 0 { pct = used * 100 / total; }
    dtext(barx + barw + 8, bary + 3, C_DIM, C_BG, pct);
    dtext(barx + barw + 30, bary + 3, C_DIM, C_BG, "%");
    dtext(x + 8, y + 110, C_DIM, C_BG, "Kernel KengaOS 0.5 x86_64 (Kenga desktop)");
    return 0;
}

/* total usable RAM in KiB, summed from the memmap in Kenga */
fn mem_total_kb() -> i64 {
    let n: i64 = mem_region_count();
    let sum: i64 = 0;
    let i: i64 = 0;
    while i < n {
        if mem_region_type(i) == 0 {
            sum = sum + mem_region_len(i) / 1024;
        }
        i = i + 1;
    }
    return sum;
}

/* --- handle a mouse click; returns updated state --- */
fn handle_click(st: DesktopState, mx: i64, my: i64) -> DesktopState {
    let W: i64 = fb_width();
    let H: i64 = fb_height();
    let m: DesktopMetrics = dmetrics(W, H);
    let TOPBAR: i64 = m.tb;
    let SIDEBAR: i64 = m.sb;
    let STATUSB: i64 = m.stb;
    /* dock FIRST: it is drawn on top of the windows and must eat its clicks
       even when an agent window overlaps the dock area */
    let dw: i64 = 64;
    let dh: i64 = 5 * 52 + 20;
    let dx: i64 = 12;
    let dy: i64 = (H - dh) / 2;
    if mx >= dx && mx < dx + dw && my >= dy && my < dy + dh {
        let idx: i64 = (my - dy - 10) / 52;
        if idx >= 0 && idx < 5 { st.cur_app = idx; }
        return st;
    }
    /* windows take precedence: bring the clicked one to front */
    let w: i64 = win_at(mx, my);
    if w >= 0 {
        ui_window_front(w);
        /* traffic-light close button (red disc, top-left) */
        let cwx: i64 = ui_window_x(w) + 18;
        let cwy: i64 = ui_window_y(w) + 22;
        if mx >= cwx - 6 && mx < cwx + 6 && my >= cwy - 6 && my < cwy + 6 {
            ui_window_close(w);
            return st;
        }
        /* if clicked on the title bar (top 44px), start dragging it */
        if my < ui_window_y(w) + 44 {
            st.drag_win = w;
            st.drag_ox = mx - ui_window_x(w);
            st.drag_oy = my - ui_window_y(w);
        }
        return st;
    }
    /* input bar send button: submit the chat line to the agent */
    let bw: i64 = W - 108 - 360;
    if mx >= 108 + bw - 100 && mx < 108 + bw - 8 && my >= H - 52 + 5 && my < H - 52 + 31 {
        ui_input_submit();
        return st;
    }
    /* main view window: app content coordinates */
    let x: i64 = 108 + 16;
    let y: i64 = TOPBAR + 18 + 52;
    if st.cur_app == 0 {
        let n: i64 = proc_count();
        let row: i64 = y + 28;
        let i: i64 = 0;
        while i < n && i < 20 {
            if mx >= x + 6 && mx < x + 180 && my >= row && my < row + 20 {
                st.sel_pid = proc_pid_at(i);
                return st;
            }
            row = row + 20;
            i = i + 1;
        }
    }
    if st.cur_app == 1 {
        if din(x + 40, y + 100, 40, 24, mx, my) == 1 { st.model_a = 0; }
        if din(x + 90, y + 100, 40, 24, mx, my) == 1 { st.model_a = 1; }
        if din(x + 40, y + 130, 40, 24, mx, my) == 1 { st.model_b = 0; }
        if din(x + 90, y + 130, 40, 24, mx, my) == 1 { st.model_b = 1; }
        if din(x, y + 60, 110, 30, mx, my) == 1 {
            st.model_out = model_infer(st.model_a, st.model_b);
            push(st.hist, st.model_a + " " + st.model_b + " = " + st.model_out);
        }
    }
    return st;
}

/* --- boot / init screen: wait for ENTER (or 2s) then open desktop --- */
fn init_screen() -> i64 {
    let C_BG: i64 = 0x05070d;
    let C_NEON: i64 = 0x22d3ee;
    let C_ACC: i64 = 0x8b7bff;
    let C_DIM: i64 = 0x4a5578;
    let C_LOG: i64 = 0x7ee7d0;
    let W: i64 = 1280;
    let H: i64 = 800;
    fb_hrect(0, 0, W, H, C_BG);
    /* big KENGAOS wordmark */
    dtext(540, 260, C_ACC, C_BG, "KENGAOS");
    dtext(530, 280, C_DIM, C_BG, "OPERATION SYSTEM NEXT-GEN");
    /* boot log lines */
    dtext(360, 340, C_LOG, C_BG, "[fb]    linear framebuffer 1280x800 @ HHDM");
    dtext(360, 352, C_LOG, C_BG, "[heap]  frame allocator ~94MB (bitmap)");
    dtext(360, 364, C_LOG, C_BG, "[idt]   GDT + IDT, exceptions caught");
    dtext(360, 376, C_LOG, C_BG, "[pit]   timer 100Hz, round-robin sched");
    dtext(360, 388, C_LOG, C_BG, "[ps/2]  keyboard + mouse, XOR cursor");
    dtext(360, 400, C_LOG, C_BG, "[vfs]   initrd mounted, UTF-8 cyrillic");
    dtext(360, 412, C_LOG, C_BG, "[init]  spawn ui-agent model-agent shell");
    dtext(360, 424, C_LOG, C_BG, "[desk]  CAP_UI: agent-native graphics env");
    dtext(500, 440, C_NEON, C_BG, "KengaOS 0.6 ready");
    /* progress bar */
    fb_hrect(360, 460, 560, 6, 0x131a2b);
    let boot_at: i64 = time_uptime_ms();
    let spins: i64 = 0;
    while 1 {
        if kbd_pending() == 1 {
            let c: i64 = kbd_read();
            if c == 10 { return 0; }
        }
        let el: i64 = time_uptime_ms() - boot_at;
        if el > 2000 { return 0; }
        let pct: i64 = el * 100 / 2000;
        if pct > 100 { pct = 100; }
        let fill: i64 = pct * 560 / 100;
        fb_hrect(360, 460, fill, 6, C_NEON);
        spins = spins + 1;
        if spins > 20000000 { return 0; }
        asm_hlt();
    }
    return 0;
}

/* --- lock screen: big clock, click/Enter to enter --- */
fn lock_screen() -> i64 {
    let C_BG: i64 = 0x04060b;
    let C_NEON: i64 = 0x22d3ee;
    let C_DIM: i64 = 0x4a5578;
    let C_ACC: i64 = 0x8b7bff;
    let W: i64 = 1280;
    let H: i64 = 800;
    fb_hrect(0, 0, W, H, C_BG);
    dtext(540, 300, C_NEON, C_BG, hw_rtc_time_str());
    dtext(520, 330, C_DIM, C_BG, "KengaOS 0.6 · GermannM3");
    dtext(470, 420, C_ACC, C_BG, "click or Enter to enter");
    let boot_at: i64 = time_uptime_ms();
    let spins: i64 = 0;
    while 1 {
        if kbd_pending() == 1 {
            let c: i64 = kbd_read();
            if c == 10 { return 0; }
        }
        let el: i64 = time_uptime_ms() - boot_at;
        if el > 2500 { return 0; }
        spins = spins + 1;
        if spins > 20000000 { return 0; }
        asm_hlt();
    }
    return 0;
}

/* --- desktop event loop (Kenga) --- */
fn desktop_main() -> i64 {
    let st: DesktopState = DesktopState{ cur_app: 0, sel_pid: 0, model_a: 0, model_b: 1, model_out: 0, drag_win: -1, drag_ox: 0, drag_oy: 0, hist: [] };
    init_screen();
    lock_screen();
    ui_system_window("welcome", "KengaOS 0.5 | agent-native desktop");
    /* let agents run once so a CAP_UI agent can open its window before first draw */
    let yc: i64 = 0;
    while yc < 8 {
        yield_agent();
        yc = yc + 1;
    }
    let mx: i64 = mouse_x();
    let my: i64 = mouse_y();
    let last_mx: i64 = mx;
    let last_my: i64 = my;
    let mprev: i64 = 0;
    let tick: i64 = 0;
    let last_up: i64 = time_uptime_ms() / 1000;
    let last_n: i64 = proc_count();
    let s: DesktopState = st;
    /* first frame through the back buffer */
    fb_begin_frame();
    draw_desktop(s);
    cur_draw(mx, my);
    fb_end_frame();
    while 1 {
        mouse_poll();   /* USB tablet poll (no-op for PS/2) */
        let bx: i64 = mouse_buttons();
        let cmx: i64 = mouse_x();
        let cmy: i64 = mouse_y();
        let clicked: i64 = 0;
        if bx != 0 && mprev == 0 { clicked = 1; }
        let released: i64 = 0;
        if bx == 0 && mprev != 0 { released = 1; }
        /* live refresh: redraw when uptime tick or agent count changes */
        let now_up: i64 = time_uptime_ms() / 1000;
        let now_n: i64 = proc_count();
        let live: i64 = 0;
        if now_up != last_up { live = 1; }
        if now_n != last_n { live = 1; }
        let dragging: i64 = 0;
        if s.drag_win >= 0 && bx != 0 { dragging = 1; }
        if clicked == 1 {
            let ns: DesktopState = handle_click(s, cmx, cmy);
            fb_begin_frame();
            draw_desktop(ns);
            cur_draw(cmx, cmy);
            fb_end_frame();
            last_up = now_up;
            last_n = now_n;
            s = ns;
        } else if kbd_pending() == 1 {
            /* keyboard: 1..4 switch apps; otherwise type into the agent bar */
            let c: i64 = kbd_read();
            if c >= 49 && c <= 53 {
                s.cur_app = c - 49;
                fb_begin_frame();
                draw_desktop(s);
                cur_draw(cmx, cmy);
                fb_end_frame();
                last_up = now_up;
                last_n = now_n;
            } else {
                let chg: i64 = 0;
                if c == 10 || c == 13 {
                    ui_input_submit();
                    chg = 1;
                } else {
                    chg = ui_input_putc(c);
                }
                if chg == 1 {
                    fb_begin_frame();
                    draw_desktop(s);
                    cur_draw(cmx, cmy);
                    fb_end_frame();
                    last_up = now_up;
                    last_n = now_n;
                }
            }
        } else if dragging == 1 && (cmx != last_mx || cmy != last_my) {
            /* drag the window under the cursor */
            ui_window_move(s.drag_win, cmx - s.drag_ox, cmy - s.drag_oy);
            fb_begin_frame();
            draw_desktop(s);
            cur_draw(cmx, cmy);
            fb_end_frame();
        } else if released == 1 && s.drag_win >= 0 {
            s.drag_win = -1;
            fb_begin_frame();
            draw_desktop(s);
            cur_draw(cmx, cmy);
            fb_end_frame();
        } else if live == 1 {
            fb_begin_frame();
            draw_desktop(s);
            cur_draw(cmx, cmy);
            fb_end_frame();
            last_up = now_up;
            last_n = now_n;
        } else if cmx != last_mx || cmy != last_my {
            cur_erase(last_mx, last_my);
            cur_draw(cmx, cmy);
        }
        mprev = bx;
        last_mx = cmx;
        last_my = cmy;
        /* give agents (logger/model/researcher) time to run */
        let t: i64 = tick;
        if t % 32 == 0 {
            yield_agent();
        }
        tick = tick + 1;
        asm_hlt();
    }
    return 0;
}
