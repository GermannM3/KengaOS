/* desktop.kenga — KengaOS 0.5: the agent desktop, written in Kenga.
 *
 * Everything that used to live in kf_gui.c (event loop, sidebar, app/agent
 * selection, all views) now lives here. C (kf_gui.c) is reduced to a thin
 * bridge that inits the hardware and calls k_desktop_main().
 */

/* --- state threaded through the desktop (Kenga has no globals) --- */
struct DesktopState { cur_app: i64, sel_pid: i64, model_a: i64, model_b: i64, model_out: i64, drag_win: i64, drag_ox: i64, drag_oy: i64, hist: list }

/* --- cursor (XOR draw; calling fb_cursor twice erases it) --- */
fn cur_draw(mx: i64, my: i64) -> i64 {
    fb_cursor(mx, my);
    return 0;
}
fn cur_erase(mx: i64, my: i64) -> i64 {
    fb_cursor(mx, my);
    return 0;
}

/* --- drawing helpers (Kenga-facing) --- */
fn drect(x: i64, y: i64, w: i64, h: i64, c: i64) -> i64 { return fb_hrect(x, y, w, h, c); }
fn dtext(x: i64, y: i64, fg: i64, bg: i64, s: str) -> i64 { return fb_text(x, y, fg, bg, s); }
fn din(x: i64, y: i64, w: i64, h: i64, mx: i64, my: i64) -> i64 {
    if mx >= x && mx < x + w && my >= y && my < y + h { return 1; }
    return 0;
}

/* --- desktop metrics, computed from the real framebuffer (adaptive layout) --- */
fn dmetrics(w: i64, h: i64) -> DesktopMetrics {
    let sb: i64 = w / 6;
    if sb < 140 { sb = 140; }
    if sb > 260 { sb = 260; }
    let tb: i64 = 40;
    if h < 500 { tb = 32; }
    return DesktopMetrics{ sb: sb, tb: tb, stb: 28 };
}

struct DesktopMetrics { sb: i64, tb: i64, stb: i64 }

/* --- redraw the whole desktop --- */
fn draw_desktop(st: DesktopState) -> i64 {
    let W: i64 = fb_width();
    let H: i64 = fb_height();
    let m: DesktopMetrics = dmetrics(W, H);
    draw_wallpaper(W, H);
    ui_chrome(W, H, m.sb, m.tb, m.stb,
              proc_count(), time_uptime_ms() / 1000, mouse_x(), mouse_y(), st.cur_app);
    let cx: i64 = m.sb;
    let cy: i64 = m.tb;
    let cw: i64 = W - m.sb;
    let ch: i64 = H - m.tb - m.stb;
    /* content renders over the wallpaper gradient (no flat fill) */
    draw_app(cx + 16, cy + 12, cw - 32, ch - 24, st);
    /* agent chat input bar at the bottom of the content area */
    draw_input_bar(W, H, m.sb, m.tb, m.stb);
    draw_log(W, H, m.sb, m.tb, m.stb);
    draw_taskbar(W, H, m.sb, m.tb, m.stb);
    draw_windows();
    return 0;
}

/* --- dock: futuristic glass bar with pixel app icons (bottom center) --- */
fn draw_taskbar(w: i64, h: i64, sb: i64, tb: i64, stb: i64) -> i64 {
    let GLASS: i64 = 0x141822;
    let HILITE: i64 = 0x8b7bff;
    let NEON: i64 = 0x22d3ee;
    let TEXT: i64 = 0xe6edf3;
    let DIM: i64 = 0x4a5578;
    let n: i64 = ui_window_count();
    let dw: i64 = 420;
    let dx: i64 = (w - dw) / 2;
    let dy: i64 = h - stb - 52;
    /* glass dock bar */
    fb_hrect(dx, dy, dw, 44, GLASS);
    fb_hrect(dx, dy, dw, 2, HILITE);      /* accent top edge */
    /* pixel app icons (12x12 in 24x28 pads) */
    let ix: i64 = dx + 10;
    icon_agents(ix, dy + 14, NEON);
    ix = ix + 44;
    icon_model(ix, dy + 14, HILITE);
    ix = ix + 44;
    icon_files(ix, dy + 14, NEON);
    ix = ix + 44;
    icon_system(ix, dy + 14, HILITE);
    ix = ix + 44;
    icon_window(ix, dy + 14, NEON);
    /* live window indicator: count */
    dtext(dx + dw - 40, dy + 16, DIM, GLASS, "win ");
    dtext(dx + dw - 20, dy + 16, HILITE, GLASS, n);
    return 0;
}

/* 12x12 pixel icons drawn from row bitmaps (MSB left). Each row is two
   chars: bits 0..7, then bits 8..11 (4 bits in the low nibble). */
fn icon_agents(x: i64, y: i64, c: i64) -> i64 {
    fb_hrect(x + 2, y + 2, 3, 3, c);            /* head */
    fb_hrect(x + 2, y + 8, 8, 3, c);            /* shoulders */
    return 0;
}
fn icon_model(x: i64, y: i64, c: i64) -> i64 {
    fb_hrect(x + 5, y + 1, 3, 3, c);            /* top node */
    fb_hrect(x + 0, y + 8, 3, 3, c);            /* left node */
    fb_hrect(x + 10, y + 8, 3, 3, c);           /* right node */
    fb_hrect(x + 5, y + 4, 3, 3, c);            /* middle node */
    return 0;
}
fn icon_files(x: i64, y: i64, c: i64) -> i64 {
    fb_hrect(x + 1, y + 2, 7, 3, c);            /* folder tab */
    fb_hrect(x + 1, y + 5, 10, 6, c);           /* folder body */
    return 0;
}
fn icon_system(x: i64, y: i64, c: i64) -> i64 {
    fb_hrect(x + 4, y + 2, 4, 9, c);            /* vertical slider */
    fb_hrect(x + 2, y + 4, 8, 2, c);            /* horizontal bar */
    return 0;
}
fn icon_window(x: i64, y: i64, c: i64) -> i64 {
    fb_hrect(x + 1, y + 1, 10, 2, c);           /* title bar */
    fb_hrect(x + 1, y + 4, 10, 7, c);           /* body */
    return 0;
}

/* --- wallpaper: futuristic blue gradient + subtle tech grid --- */
fn draw_wallpaper(w: i64, h: i64) -> i64 {
    /* vertical gradient: deep blue top -> darker blue bottom */
    let bands: i64 = 40;
    let bh: i64 = h / bands;
    if bh < 1 { bh = 1; }
    let b: i64 = 0;
    while b < bands {
        let t: i64 = b * 255 / bands;
        let r: i64 = 0x1e - t * 10 / 255;     /* ~#1E3A8A top */
        let g: i64 = 0x3a - t * 22 / 255;
        let bl: i64 = 0x8a - t * 30 / 255;
        let c: i64 = (r << 16) | (g << 8) | bl;
        fb_hrect(0, b * bh, w, bh, c);
        b = b + 1;
    }
    /* tech grid: thin vertical + horizontal lines (low-alpha look) */
    let GRID: i64 = 0x2a4f96;
    let gx: i64 = 0;
    while gx < w {
        fb_hrect(gx, 0, 1, h, GRID);
        gx = gx + 32;
    }
    let gy: i64 = 0;
    while gy < h {
        fb_hrect(0, gy, w, 1, GRID);
        gy = gy + 32;
    }
    return 0;
}

/* --- live agent event log (notifications above the input bar) --- */
fn draw_log(w: i64, h: i64, sb: i64, tb: i64, stb: i64) -> i64 {
    let C_PANEL: i64 = 0x141822;
    let C_DIM: i64 = 0x8fb3d9;
    let C_GREEN: i64 = 0x22d3ee;
    let C_TEXT: i64 = 0xe6edf3;
    let ly: i64 = h - stb - 26 - 24;
    fb_hrect(sb, ly, w - sb, 24, C_PANEL);
    dtext(sb + 10, ly + 8, C_GREEN, C_PANEL, "log:");
    dtext(sb + 44, ly + 8, C_TEXT, C_PANEL, ui_log_at(0));
    return 0;
}

/* --- agent chat input bar: "> <typed text>" --- */
fn draw_input_bar(w: i64, h: i64, sb: i64, tb: i64, stb: i64) -> i64 {
    let C_PANEL: i64 = 0x141822;
    let C_ACCENT: i64 = 0x8b7bff;
    let C_TEXT: i64 = 0xe6edf3;
    let C_DIM: i64 = 0x8fb3d9;
    let C_GREEN: i64 = 0x22d3ee;
    let y: i64 = h - stb - 26;
    fb_hrect(sb, y, w - sb, 26, C_PANEL);
    fb_text(sb + 10, y + 9, C_GREEN, C_PANEL, "> ");
    fb_text(sb + 26, y + 9, C_TEXT, C_PANEL, ui_input_str());
    let il: i64 = ui_input_len();
    fb_text(sb + 26 + il * 8, y + 9, C_ACCENT, C_PANEL, "_");
    fb_text(w - 60, y + 9, C_DIM, C_PANEL, "Enter");
    return 0;
}

/* --- agent-created windows, drawn on top (sorted by z, later = higher) --- */
fn draw_windows() -> i64 {
    let C_PANEL: i64 = 0x141822;
    let C_PANEL2: i64 = 0x1a2030;
    let C_ACCENT: i64 = 0x8b7bff;
    let C_TEXT: i64 = 0xe6edf3;
    let C_DIM: i64 = 0x8fb3d9;
    let C_RED: i64 = 0xff5f57;
    let C_YEL: i64 = 0xfebc2e;
    let C_GRN: i64 = 0x28c840;
    let n: i64 = ui_window_count();
    if n == 0 { return 0; }
    /* draw in z order: lowest z first, highest last (on top).
       Iterate z values 1.. so each window is drawn exactly once. */
    let z: i64 = 1;
    let drawn: i64 = 0;
    while drawn < n {
        let i: i64 = 0;
        let found: i64 = -1;
        while i < n {
            if ui_window_z(i) == z { found = i; }
            i = i + 1;
        }
        if found >= 0 {
            let wx: i64 = ui_window_x(found);
            let wy: i64 = ui_window_y(found);
            let ww: i64 = ui_window_w(found);
            let wh: i64 = ui_window_h(found);
            /* glass window body + titlebar with accent top edge */
            fb_hrect(wx, wy, ww, wh, C_PANEL);
            fb_hrect(wx, wy, ww, 18, C_PANEL2);
            fb_hrect(wx, wy, ww, 2, C_ACCENT);
            /* traffic-light close button (red, left) */
            fb_hrect(wx + 6, wy + 6, 7, 7, C_RED);
            /* yellow + green indicators (decorative for now) */
            fb_hrect(wx + 16, wy + 6, 7, 7, C_YEL);
            fb_hrect(wx + 26, wy + 6, 7, 7, C_GRN);
            dtext(wx + 38, wy + 5, C_ACCENT, C_PANEL2, ui_window_title(found));
            dtext(wx + 6, wy + 26, C_TEXT, C_PANEL, ui_window_text(found));
            drawn = drawn + 1;
        }
        z = z + 1;
    }
    return 0;
}

/* find the topmost window containing (mx,my); returns its index or -1 */
fn win_at(mx: i64, my: i64) -> i64 {
    let n: i64 = ui_window_count();
    if n == 0 { return -1; }
    let best: i64 = -1;
    let bestz: i64 = -1;
    let i: i64 = 0;
    while i < n {
        let wx: i64 = ui_window_x(i);
        let wy: i64 = ui_window_y(i);
        let ww: i64 = ui_window_w(i);
        let wh: i64 = ui_window_h(i);
        if mx >= wx && mx < wx + ww && my >= wy && my < wy + wh {
            if ui_window_z(i) > bestz { bestz = ui_window_z(i); best = i; }
        }
        i = i + 1;
    }
    return best;
}

/* --- render the selected app's content --- */
fn draw_app(x: i64, y: i64, w: i64, h: i64, st: DesktopState) -> i64 {
    if st.cur_app == 0 { return draw_agents(x, y, w, h, st); }
    if st.cur_app == 1 { return draw_model(x, y, w, h, st); }
    if st.cur_app == 2 { return draw_files(x, y, w, h, st); }
    if st.cur_app == 3 { return draw_system(x, y, w, h, st); }
    return 0;
}

fn draw_agents(x: i64, y: i64, w: i64, h: i64, st: DesktopState) -> i64 {
    let C_BG: i64 = 0x10131c;
    let C_TEXT: i64 = 0xe6edf3;
    let C_ACCENT: i64 = 0x8b7bff;
    let C_DIM: i64 = 0x8fb3d9;
    let C_HILITE: i64 = 0x8b7bff;
    let C_GREEN: i64 = 0x22d3ee;
    let C_PANEL2: i64 = 0x1a2030;
    dtext(x, y, C_TEXT, C_BG, "Agents (process tree)");
    let n: i64 = proc_count();
    let row: i64 = y + 28;
    let i: i64 = 0;
    while i < n && i < 20 {
        let flag: i64 = 0;
        if proc_pid_at(i) == st.sel_pid { flag = 1; }
        let bg: i64 = C_BG;
        if flag == 1 { bg = C_HILITE; }
        fb_hrect(x, row, w, 20, bg);
        dtext(x + 6, row + 4, C_ACCENT, bg, proc_pid_at(i));
        dtext(x + 40, row + 4, C_TEXT, bg, proc_name_at(i));
        dtext(x + 120, row + 4, C_DIM, bg, "p:");
        dtext(x + 134, row + 4, C_DIM, bg, proc_parent_at(i));
        dtext(x + 200, row + 4, C_DIM, bg, "q:");
        dtext(x + 214, row + 4, C_DIM, bg, proc_qlen(proc_pid_at(i)));
        row = row + 20;
        i = i + 1;
    }
    /* details of selected */
    if st.sel_pid > 0 {
        let dy: i64 = y + 28 + 20 * n + 8;
        if n > 20 { dy = y + 28 + 20 * 20 + 8; }
        fb_hrect(x, dy, w, h - (dy - y), C_PANEL2);
        dtext(x + 12, dy + 8, C_GREEN, C_PANEL2, "Selected agent");
        dtext(x + 12, dy + 28, C_TEXT, C_PANEL2, "PID  " + st.sel_pid);
        let j: i64 = 0;
        while j < n {
            if proc_pid_at(j) == st.sel_pid {
                dtext(x + 12, dy + 48, C_TEXT, C_PANEL2, "Name " + proc_name_at(j));
                dtext(x + 12, dy + 68, C_TEXT, C_PANEL2, "Caps " + proc_caps(st.sel_pid));
            }
            j = j + 1;
        }
    }
    return 0;
}

fn draw_model(x: i64, y: i64, w: i64, h: i64, st: DesktopState) -> i64 {
    let C_BG: i64 = 0x10131c;
    let C_TEXT: i64 = 0xe6edf3;
    let C_DIM: i64 = 0x8fb3d9;
    let C_PANEL2: i64 = 0x1a2030;
    let C_HILITE: i64 = 0x8b7bff;
    let C_ACCENT: i64 = 0x8b7bff;
    let C_GREEN: i64 = 0x22d3ee;
    dtext(x, y, C_TEXT, C_BG, "Kenga Model (MLP, XOR)");
    dtext(x, y + 30, C_DIM, C_BG, "in1");
    fb_hrect(x + 40, y + 26, 60, 24, C_PANEL2);
    dtext(x + 48, y + 32, C_TEXT, C_PANEL2, st.model_a);
    dtext(x + 130, y + 30, C_DIM, C_BG, "in2");
    fb_hrect(x + 170, y + 26, 60, 24, C_PANEL2);
    dtext(x + 178, y + 32, C_TEXT, C_PANEL2, st.model_b);
    fb_hrect(x, y + 60, 110, 30, C_ACCENT);
    dtext(x + 16, y + 68, C_BG, C_ACCENT, "Inference");
    fb_hrect(x + 40, y + 100, 40, 24, C_HILITE);
    dtext(x + 52, y + 106, C_TEXT, C_HILITE, "0");
    fb_hrect(x + 90, y + 100, 40, 24, C_HILITE);
    dtext(x + 102, y + 106, C_TEXT, C_HILITE, "1");
    dtext(x + 170, y + 106, C_DIM, C_BG, "in1");
    fb_hrect(x + 40, y + 130, 40, 24, C_HILITE);
    dtext(x + 52, y + 136, C_TEXT, C_HILITE, "0");
    fb_hrect(x + 90, y + 130, 40, 24, C_HILITE);
    dtext(x + 102, y + 136, C_TEXT, C_HILITE, "1");
    dtext(x + 170, y + 136, C_DIM, C_BG, "in2");
    dtext(x, y + 180, C_GREEN, C_BG, "output:");
    dtext(x + 80, y + 180, C_TEXT, C_BG, st.model_out);
    /* inference history (last runs) */
    dtext(x, y + 210, C_DIM, C_BG, "history:");
    let hi: i64 = 0;
    for v in st.hist {
        if hi < 8 {
            dtext(x + 8, y + 222 + hi * 18, C_TEXT, C_BG, v);
        }
        hi = hi + 1;
    }
    return 0;
}

fn draw_files(x: i64, y: i64, w: i64, h: i64, st: DesktopState) -> i64 {
    let C_BG: i64 = 0x10131c;
    let C_TEXT: i64 = 0xe6edf3;
    let C_DIM: i64 = 0x8fb3d9;
    dtext(x, y, C_TEXT, C_BG, "Files (VFS)");
    let n: i64 = vfs_count();
    let i: i64 = 0;
    while i < n && i < 20 {
        dtext(x + 8, y + 24 + i * 20, C_TEXT, C_BG, vfs_name(i));
        dtext(x + 120, y + 24 + i * 20, C_DIM, C_BG, "cat to view");
        i = i + 1;
    }
    return 0;
}

fn draw_system(x: i64, y: i64, w: i64, h: i64, st: DesktopState) -> i64 {
    let C_BG: i64 = 0x10131c;
    let C_TEXT: i64 = 0xe6edf3;
    let C_DIM: i64 = 0x8fb3d9;
    let C_PANEL2: i64 = 0x1a2030;
    let C_GREEN: i64 = 0x22d3ee;
    dtext(x, y, C_TEXT, C_BG, "System");
    dtext(x + 8, y + 24, C_TEXT, C_BG, "CPU  " + hw_cpu_brand_str());
    dtext(x + 8, y + 44, C_TEXT, C_BG, "RAM free " + mem_pages_free());
    dtext(x + 8, y + 64, C_TEXT, C_BG, "Uptime " + time_uptime_ms() / 1000);
    /* live RAM bar, computed in Kenga: total = sum of usable memmap regions
       (type 0), used = total - free. Nothing here touches C logic. */
    let total: i64 = mem_total_kb();
    let used: i64 = 0;
    if total > 0 { used = total - mem_pages_free() * 4; }
    let barw: i64 = 300;
    let barx: i64 = x + 8;
    let bary: i64 = y + 88;
    fb_hrect(barx, bary, barw, 14, C_PANEL2);
    if total > 0 {
        let fill: i64 = used * barw / total;
        if fill > barw { fill = barw; }
        if fill > 0 { fb_hrect(barx, bary, fill, 14, C_GREEN); }
    }
    let pct: i64 = 0;
    if total > 0 { pct = used * 100 / total; }
    dtext(barx + barw + 8, bary + 3, C_DIM, C_BG, pct);
    dtext(barx + barw + 30, bary + 3, C_DIM, C_BG, "%");
    dtext(x + 8, y + 110, C_DIM, C_BG, "Kernel KengaOS 0.5 x86_64 (Kenga desktop)");
    return 0;
}

/* total usable RAM in KiB, summed from the memmap in Kenga */
fn mem_total_kb() -> i64 {
    let n: i64 = mem_region_count();
    let sum: i64 = 0;
    let i: i64 = 0;
    while i < n {
        if mem_region_type(i) == 0 {
            sum = sum + mem_region_len(i) / 1024;
        }
        i = i + 1;
    }
    return sum;
}

/* --- handle a mouse click; returns updated state --- */
fn handle_click(st: DesktopState, mx: i64, my: i64) -> DesktopState {
    let W: i64 = fb_width();
    let H: i64 = fb_height();
    let m: DesktopMetrics = dmetrics(W, H);
    let TOPBAR: i64 = m.tb;
    let SIDEBAR: i64 = m.sb;
    let STATUSB: i64 = m.stb;
    /* windows take precedence: bring the clicked one to front */
    let w: i64 = win_at(mx, my);
    if w >= 0 {
        ui_window_front(w);
        /* traffic-light close button (red dot, top-left) */
        let cwx: i64 = ui_window_x(w) + 6;
        let cwy: i64 = ui_window_y(w) + 6;
        if mx >= cwx && mx < cwx + 7 && my >= cwy && my < cwy + 7 {
            ui_window_close(w);
            return st;
        }
        /* if clicked on the title bar (top 18px), start dragging it */
        if my < ui_window_y(w) + 18 {
            st.drag_win = w;
            st.drag_ox = mx - ui_window_x(w);
            st.drag_oy = my - ui_window_y(w);
        }
        return st;
    }
    /* taskbar: click a window button to raise it */
    let ty: i64 = H - STATUSB - 24;
    if my >= ty && my < ty + 24 && mx >= SIDEBAR + 60 {
        let n: i64 = ui_window_count();
        let bx: i64 = SIDEBAR + 60;
        let i: i64 = 0;
        while i < n {
            if mx >= bx && mx < bx + 96 && my >= ty + 4 && my < ty + 20 {
                ui_window_front(i);
                return st;
            }
            bx = bx + 96 + 4;
            i = i + 1;
        }
    }
    /* sidebar app switch */
    if mx < SIDEBAR && my > TOPBAR && my < H - STATUSB {
        let idx: i64 = (my - TOPBAR - 12) / 44;
        if idx >= 0 && idx < 4 { st.cur_app = idx; }
        return st;
    }
    let x: i64 = SIDEBAR + 16;
    let y: i64 = TOPBAR + 12;
    if st.cur_app == 0 {
        let n: i64 = proc_count();
        let row: i64 = y + 28;
        let i: i64 = 0;
        while i < n && i < 20 {
            if mx >= x + 6 && mx < x + 180 && my >= row && my < row + 20 {
                st.sel_pid = proc_pid_at(i);
                return st;
            }
            row = row + 20;
            i = i + 1;
        }
    }
    if st.cur_app == 1 {
        if din(x + 40, y + 100, 40, 24, mx, my) == 1 { st.model_a = 0; }
        if din(x + 90, y + 100, 40, 24, mx, my) == 1 { st.model_a = 1; }
        if din(x + 40, y + 130, 40, 24, mx, my) == 1 { st.model_b = 0; }
        if din(x + 90, y + 130, 40, 24, mx, my) == 1 { st.model_b = 1; }
        if din(x, y + 60, 110, 30, mx, my) == 1 {
            st.model_out = model_infer(st.model_a, st.model_b);
            push(st.hist, st.model_a + " " + st.model_b + " = " + st.model_out);
        }
    }
    return st;
}

/* --- boot / init screen: wait for ENTER (or 2s) then open desktop --- */
fn init_screen() -> i64 {
    let C_BG: i64 = 0x05070d;
    let C_NEON: i64 = 0x22d3ee;
    let C_ACC: i64 = 0x8b7bff;
    let C_DIM: i64 = 0x4a5578;
    let C_LOG: i64 = 0x7ee7d0;
    let W: i64 = 1280;
    let H: i64 = 800;
    fb_hrect(0, 0, W, H, C_BG);
    /* big KENGAOS wordmark */
    dtext(540, 260, C_ACC, C_BG, "KENGAOS");
    dtext(530, 280, C_DIM, C_BG, "OPERATION SYSTEM NEXT-GEN");
    /* boot log lines */
    dtext(360, 340, C_LOG, C_BG, "[fb]    linear framebuffer 1280x800 @ HHDM");
    dtext(360, 352, C_LOG, C_BG, "[heap]  frame allocator ~94MB (bitmap)");
    dtext(360, 364, C_LOG, C_BG, "[idt]   GDT + IDT, exceptions caught");
    dtext(360, 376, C_LOG, C_BG, "[pit]   timer 100Hz, round-robin sched");
    dtext(360, 388, C_LOG, C_BG, "[ps/2]  keyboard + mouse, XOR cursor");
    dtext(360, 400, C_LOG, C_BG, "[vfs]   initrd mounted, UTF-8 cyrillic");
    dtext(360, 412, C_LOG, C_BG, "[init]  spawn ui-agent model-agent shell");
    dtext(360, 424, C_LOG, C_BG, "[desk]  CAP_UI: agent-native graphics env");
    dtext(500, 440, C_NEON, C_BG, "KengaOS 0.6 ready");
    /* progress bar */
    fb_hrect(360, 460, 560, 6, 0x131a2b);
    let boot_at: i64 = time_uptime_ms();
    let spins: i64 = 0;
    while 1 {
        if kbd_pending() == 1 {
            let c: i64 = kbd_read();
            if c == 10 { return 0; }
        }
        let el: i64 = time_uptime_ms() - boot_at;
        if el > 2000 { return 0; }
        let pct: i64 = el * 100 / 2000;
        if pct > 100 { pct = 100; }
        let fill: i64 = pct * 560 / 100;
        fb_hrect(360, 460, fill, 6, C_NEON);
        spins = spins + 1;
        if spins > 20000000 { return 0; }
        asm_hlt();
    }
    return 0;
}

/* --- lock screen: big clock, click/Enter to enter --- */
fn lock_screen() -> i64 {
    let C_BG: i64 = 0x04060b;
    let C_NEON: i64 = 0x22d3ee;
    let C_DIM: i64 = 0x4a5578;
    let C_ACC: i64 = 0x8b7bff;
    let W: i64 = 1280;
    let H: i64 = 800;
    fb_hrect(0, 0, W, H, C_BG);
    dtext(540, 300, C_NEON, C_BG, hw_rtc_time_str());
    dtext(520, 330, C_DIM, C_BG, "KengaOS 0.6 · GermannM3");
    dtext(470, 420, C_ACC, C_BG, "click or Enter to enter");
    let boot_at: i64 = time_uptime_ms();
    let spins: i64 = 0;
    while 1 {
        if kbd_pending() == 1 {
            let c: i64 = kbd_read();
            if c == 10 { return 0; }
        }
        let el: i64 = time_uptime_ms() - boot_at;
        if el > 2500 { return 0; }
        spins = spins + 1;
        if spins > 20000000 { return 0; }
        asm_hlt();
    }
    return 0;
}

/* --- desktop event loop (Kenga) --- */
fn desktop_main() -> i64 {
    let st: DesktopState = DesktopState{ cur_app: 0, sel_pid: 0, model_a: 0, model_b: 1, model_out: 0, drag_win: -1, drag_ox: 0, drag_oy: 0, hist: [] };
    init_screen();
    lock_screen();
    ui_system_window("welcome", "KengaOS 0.5 | agent-native desktop");
    /* let agents run once so a CAP_UI agent can open its window before first draw */
    let yc: i64 = 0;
    while yc < 8 {
        yield_agent();
        yc = yc + 1;
    }
    draw_desktop(st);
    let mx: i64 = mouse_x();
    let my: i64 = mouse_y();
    cur_draw(mx, my);
    let last_mx: i64 = mx;
    let last_my: i64 = my;
    let mprev: i64 = 0;
    let tick: i64 = 0;
    let last_up: i64 = time_uptime_ms() / 1000;
    let last_n: i64 = proc_count();
    let s: DesktopState = st;
    while 1 {
        let bx: i64 = mouse_buttons();
        let cmx: i64 = mouse_x();
        let cmy: i64 = mouse_y();
        let clicked: i64 = 0;
        if bx != 0 && mprev == 0 { clicked = 1; }
        let released: i64 = 0;
        if bx == 0 && mprev != 0 { released = 1; }
        /* live refresh: redraw when uptime tick or agent count changes */
        let now_up: i64 = time_uptime_ms() / 1000;
        let now_n: i64 = proc_count();
        let live: i64 = 0;
        if now_up != last_up { live = 1; }
        if now_n != last_n { live = 1; }
        let dragging: i64 = 0;
        if s.drag_win >= 0 && bx != 0 { dragging = 1; }
        if clicked == 1 {
            let ns: DesktopState = handle_click(s, cmx, cmy);
            cur_erase(last_mx, last_my);
            draw_desktop(ns);
            cur_draw(cmx, cmy);
            last_up = now_up;
            last_n = now_n;
            s = ns;
        } else if kbd_pending() == 1 {
            /* keyboard: 1..4 switch apps; otherwise type into the agent bar */
            let c: i64 = kbd_read();
            if c >= 49 && c <= 52 {
                s.cur_app = c - 49;
                cur_erase(last_mx, last_my);
                draw_desktop(s);
                cur_draw(cmx, cmy);
                last_up = now_up;
                last_n = now_n;
            } else {
                let chg: i64 = 0;
                if c == 10 || c == 13 {
                    ui_input_submit();
                    chg = 1;
                } else {
                    chg = ui_input_putc(c);
                }
                if chg == 1 {
                    cur_erase(last_mx, last_my);
                    draw_desktop(s);
                    cur_draw(cmx, cmy);
                    last_up = now_up;
                    last_n = now_n;
                }
            }
        } else if dragging == 1 && (cmx != last_mx || cmy != last_my) {
            /* drag the window under the cursor */
            ui_window_move(s.drag_win, cmx - s.drag_ox, cmy - s.drag_oy);
            cur_erase(last_mx, last_my);
            draw_desktop(s);
            cur_draw(cmx, cmy);
        } else if released == 1 && s.drag_win >= 0 {
            s.drag_win = -1;
            cur_erase(last_mx, last_my);
            draw_desktop(s);
            cur_draw(cmx, cmy);
        } else if live == 1 {
            cur_erase(last_mx, last_my);
            draw_desktop(s);
            cur_draw(cmx, cmy);
            last_up = now_up;
            last_n = now_n;
        } else if cmx != last_mx || cmy != last_my {
            cur_erase(last_mx, last_my);
            cur_draw(cmx, cmy);
        }
        mprev = bx;
        last_mx = cmx;
        last_my = cmy;
        /* give agents (logger/model/researcher) time to run */
        let t: i64 = tick;
        if t % 32 == 0 {
            yield_agent();
        }
        tick = tick + 1;
        asm_hlt();
    }
    return 0;
}
