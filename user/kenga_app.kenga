/* kenga_app.kenga — пользовательское приложение KengaOS, НАПИСАННОЕ НА KENGA
 * и работающее в ring 3. Один и тот же ELF запускается двумя ПРОЦЕССАМИ
 * (кооперативная многозадачность: sys_yield переключает их), каждый со своей
 * PML4 и своим pid.
 *
 * Сборка: scripts/build-user.sh
 *   kenga emit-c --freestanding -> патч println -> clang -> elf-shrink.py
 *   -> /apps/kenga-app.elf в KengaFS
 *
 * Размер важен: ELF целиком читается в 4 КиБ буфер ядра, поэтому длинные
 * цепочки конкатенаций (они тянут itoa+kstr_concat) здесь не приветствуются. */

@intrinsic fn sys_yield() -> i64;
@intrinsic fn sys_getpid() -> i64;
@intrinsic fn sys_sleep(ms: i64) -> i64;
@intrinsic fn sys_uptime() -> i64;
@intrinsic fn sys_exit_code(code: i64) -> i64;
@intrinsic fn sys_mkdir(path: str) -> i64;
@intrinsic fn sys_rm(path: str) -> i64;   /* реализован (syscall 19), в демо не зовём */
@intrinsic fn sys_cat(path: str, dst: i64, max: i64) -> i64;
@intrinsic fn sys_save(path: str, data: str, n: i64) -> i64;
@intrinsic fn rt_buf() -> i64;      /* 4 КиБ буфер приложения (runtime) */
@intrinsic fn rt_str(addr: i64) -> str;

fn main() -> i64 {
    let pid: i64 = sys_getpid();
    println("kenga-app: ring3 OK");

    /* спим по-настоящему: ядро отдаёт CPU второму процессу, таймер будит */
    let t0: i64 = sys_uptime();
    sys_sleep(300);
    let t1: i64 = sys_uptime();
    if t1 - t0 >= 300 {
        println("kenga-app: sleep ok");
    } else {
        println("kenga-app: sleep too short");
    }

    /* три «тикта» с добровольной уступкой CPU — второй процесс перемежается */
    let t: i64 = 0;
    while t < 3 {
        println("kenga-app[" + pid + "]: tick " + t);
        sys_yield();
        t = t + 1;
    }

    /* читаем файл с диска: ядро (KengaFS) -> syscall 16 -> буфер приложения */
    let n: i64 = sys_cat("/system/bootlog.txt", rt_buf(), 256);
    if n > 0 {
        println("kenga-app: read /system/bootlog.txt:");
        println(rt_str(rt_buf()));
    }

    /* пишем свой файл на диск (syscall 17) */
    /* Длина задаётся явно: len() на строке, собранной конкатенацией В РАНТАЙМЕ,
       возвращает 0 (найдено в 14-м круге: литерал сохраняется, а собранная
       строка — нет). Литерал с фиксированной длиной работает. */
    sys_save("/apps/state.txt", "kenga-app was here", 18);
    println("kenga-app: saved /apps/state.txt");

    /* приложение само управляет ФС: каталог + файл внутри него
       (syscalls 18 и 17). Раньше казалось, что mkdir портит KengaFS, — на
       деле ядро не восстанавливало регистры, и sys_save получал мусор. */
    let d: i64 = sys_mkdir("/apps/demo");
    println("kenga-app: mkdir /apps/demo");
    if d >= 0 {
        sys_save("/apps/demo/hello.txt", "hi from kenga-app", 17);
        println("kenga-app: wrote /apps/demo/hello.txt");
        /* удаляем второй файл — проверяем syscall 19 (rm) из приложения */
        sys_save("/apps/demo/bye.txt", "bye", 3);
        if sys_rm("/apps/demo/bye.txt") == 0 {
            println("kenga-app: rm /apps/demo/bye.txt");
        }
    }
    /* код завершения у каждого процесса свой — ядро его сохраняет и печатает */
    if pid == 100 {
        sys_exit_code(0);
    } else {
        sys_exit_code(7);
    }
    return 0;
}
