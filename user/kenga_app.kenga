/* kenga_app.kenga — пользовательское приложение KengaOS, НАПИСАННОЕ НА KENGA
 * и работающее в ring 3. Один и тот же ELF запускается двумя ПРОЦЕССАМИ
 * (кооперативная многозадачность: sys_yield переключает их), каждый со своей
 * PML4 и своим pid.
 *
 * Сборка: scripts/build-user.sh
 *   kenga emit-c --freestanding -> патч println -> clang -> elf-shrink.py
 *   -> /apps/kenga-app.elf в KengaFS
 *
 * Размер важен: ELF целиком читается в 4 КиБ буфер ядра, поэтому длинные
 * цепочки конкатенаций (они тянут itoa+kstr_concat) здесь не приветствуются. */

@intrinsic fn sys_yield() -> i64;
@intrinsic fn sys_getpid() -> i64;
@intrinsic fn sys_cat(path: str, dst: i64, max: i64) -> i64;
@intrinsic fn sys_save(path: str, data: str, n: i64) -> i64;
@intrinsic fn rt_buf() -> i64;      /* 4 КиБ буфер приложения (runtime) */
@intrinsic fn rt_str(addr: i64) -> str;

fn main() -> i64 {
    let pid: i64 = sys_getpid();
    println("kenga-app: ring3 OK");

    /* три «тикта» с добровольной уступкой CPU — второй процесс перемежается */
    let t: i64 = 0;
    while t < 3 {
        println("kenga-app[" + pid + "]: tick " + t);
        sys_yield();
        t = t + 1;
    }

    /* читаем файл с диска: ядро (KengaFS) -> syscall 16 -> буфер приложения */
    let n: i64 = sys_cat("/system/bootlog.txt", rt_buf(), 256);
    if n > 0 {
        println("kenga-app: read /system/bootlog.txt:");
        println(rt_str(rt_buf()));
    }

    /* пишем свой файл на диск (syscall 17) */
    let msg: str = "kenga-app was here: pid=" + pid;
    sys_save("/apps/state.txt", msg, len(msg));
    println("kenga-app: saved /apps/state.txt");
    return 0;
}
