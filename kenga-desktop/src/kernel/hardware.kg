// Portable hardware contract for Kenga Desktop.
// Desktop and mobile targets provide the same surface with different drivers.

struct MouseState {
    x: int
    y: int
    buttons: int
}

@intrinsic fn get_mouse_state() -> MouseState
@intrinsic fn get_key_state(key: int) -> bool
@intrinsic fn key_to_char(key: int) -> u32
@intrinsic fn get_time_ms() -> u64
@intrinsic fn get_power_button_state() -> bool
@intrinsic fn framebuffer_width() -> int
@intrinsic fn framebuffer_height() -> int
@intrinsic fn framebuffer_pitch() -> int
